<!DOCTYPE html><html lang="it"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no"><title>SPEDIZIONE · MEMORIE DEL COSMO</title>
<style>
*{margin:0;padding:0;box-sizing:border-box}html,body{height:100%;overflow:hidden;background:#050607;font-family:ui-monospace,"Courier New",monospace;color:#cfd3d6;-webkit-user-select:none;user-select:none}
#cv{display:block;touch-action:none}
#crt{position:fixed;inset:0;pointer-events:none;z-index:10;background:repeating-linear-gradient(0deg,rgba(0,0,0,.13) 0,rgba(0,0,0,.13) 1px,transparent 1px,transparent 3px)}
#crt::after{content:"";position:absolute;inset:0;background:radial-gradient(ellipse at center,rgba(0,0,0,0) 55%,rgba(0,0,0,.4) 100%);box-shadow:inset 0 0 120px rgba(0,0,0,.45)}
#hint{position:fixed;left:0;right:0;bottom:8px;text-align:center;font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:#5a6166;z-index:11;text-shadow:0 0 6px #000}
#ver{position:fixed;left:10px;bottom:26px;z-index:20;font:700 9px ui-monospace,monospace;letter-spacing:.18em;color:#4a5257;pointer-events:none;text-shadow:0 0 6px #000}
#back{position:fixed;top:12px;right:12px;z-index:20;font:700 11px ui-monospace,monospace;letter-spacing:.14em;color:#8a9298;text-decoration:none;background:#0a0c0e;border:1px solid #22282c;padding:8px 12px}#back:hover{color:#e8b44a;border-color:#e8b44a}
</style></head><body>
<canvas id="cv"></canvas><div id="crt"></div>
<a id="back" href="../gioco.html?stanza=cosmo">&larr; MEMORIE DEL COSMO</a>
<div id="ver">MEMORIE DEL COSMO · MISSIONE 1 · TIX-9</div>
<div id="hint">A/D muovi · SPAZIO salta · W/S scale · mouse mira · click spara · 1/2 armi · E prendi / consegna · R ricomincia</div>
<script>"use strict";
(function(){
/* ============================================================
   MEMORIE DEL COSMO — LE OTTO SPEDIZIONI
   La mappa e' una citta' grande: si scorre a destra e a sinistra
   ma anche in su e in giu' (tetti, strada, fogne). Il coniglio e'
   quello del museo. Le armi sono quelle scelte in sala d'armi.
   Si prende la cassetta, e da quel momento il cielo ha un occhio:
   il tempo della memoria comincia a scendere, e l'Occhio ti cerca dal cielo.
   Torni al furgone prima che ti veda, o diventi margherita.
   ============================================================ */
/* ============================================================
   LE OTTO MISSIONI — una cassetta, un gioco.
   La pagina è una sola, ma non è la stessa partita: il numero in
   fondo all'indirizzo (cosmo/index.html?m=3) decide quale cassetta
   stai cercando. Cassetta N = gioco N = tgN.MP3: la radio che suona
   qui dentro è quella della cassetta, e la stazione è la stessa di
   RadioKaoSs (tg del cosmo). Più il numero sale, più il tempo
   scende, più la strada si riempie e meno tempo hai prima che
   l'Occhio ti veda.
   ============================================================ */
var QM=/[?&](?:m|g)=(\d+)/.exec(location.search||"");
var MEM=parseInt(QM?QM[1]:"1",10);
if(!(MEM>=1&&MEM<=8))MEM=1;
/* i posti: la strada sta a 1580, i tetti fra 940 e 1250, le fogne a
   2280. La cassetta cambia piano ogni volta, il furgone resta in
   strada ma non sempre dallo stesso lato. */
var MISSIONS=[
  {n:1,it:"MEMORIE DEL COSMO",nome:"TIX-9",timer:40,hp:5,foes:1,
   cass:{x:4780,y:2280},exit:{x:300,y:1580},notes:["m12","m11","m13"],where:"e' in fondo alle fogne"},
  {n:2,it:"IL SOTTOSUOLO",nome:"TIX-8",timer:38,hp:5,foes:1.2,
   cass:{x:2970,y:1000},exit:{x:5150,y:1580},notes:["m12","m11"],where:"e' su un tetto, sopra il pozzo"},
  {n:3,it:"IL DIAVOLO",nome:"TIX-7",timer:36,hp:4,foes:1.4,
   cass:{x:2450,y:1580},exit:{x:400,y:1580},notes:["m11","m13"],where:"e' in mezzo alla strada, sotto la luna rotta"},
  {n:4,it:"LA GUERRA DEI CONIGLI",nome:"TIX-6",timer:34,hp:4,foes:1.6,
   cass:{x:4620,y:940},exit:{x:5150,y:1580},notes:["m12","m13"],where:"e' sul tetto piu' alto, quello di destra"},
  {n:5,it:"TG DEL COSMO",nome:"TIX-5",timer:32,hp:3,foes:1.8,
   cass:{x:1200,y:2280},exit:{x:900,y:1580},notes:["m12","m11","m13"],where:"e' nelle fogne, dalla parte sbagliata"},
  {n:6,it:"LA DANZA",nome:"TIX-4",timer:30,hp:3,foes:2,
   cass:{x:2220,y:1230},exit:{x:5150,y:1580},notes:["m13"],where:"e' sul tetto di mezzo, dove si ballava"},
  {n:7,it:"L'OCCHIO NEL CIELO",nome:"TIX-3",timer:28,hp:3,foes:2.2,
   cass:{x:4700,y:1580},exit:{x:400,y:1580},notes:["m11","m12"],where:"e' in strada, in fondo al terzo isolato"},
  {n:8,it:"DOPO TIX",nome:"TIX-2",timer:26,hp:2,foes:2.4,
   cass:{x:610,y:1240},exit:{x:5150,y:1580},notes:["m12","m11","m13"],where:"e' sul primo tetto, quello da cui si vede tutto"}
];
var MZ=MISSIONS[MEM-1];
document.title="MISSIONE "+MEM+" · "+MZ.it+" · MEMORIE DEL COSMO";
function returnToCosmo(){
  var dest="../gioco.html?stanza=cosmo";
  try{
    if(document.referrer && document.referrer.indexOf("museo.html")>=0) dest="../museo.html?stanza=cosmo";
  }catch(e){}
  location.href=dest;
}
(function(){
  var b=document.getElementById("back");
  if(b && document.referrer && document.referrer.indexOf("museo.html")>=0) b.href="../museo.html?stanza=cosmo";
})();
(function(){
  var v=document.getElementById("ver");
  if(v)v.textContent="MEMORIE DEL COSMO · MISSIONE "+MEM+" · "+MZ.nome;
  var h=document.getElementById("hint");
  if(h)h.textContent="A/D muovi · SPAZIO salta · W/S scale · mouse mira · click spara · 1/2 armi · "+
    "E prendi / consegna · M radio · R ricomincia";
})();
/* ---- la radio della cassetta: tg N.MP3, quella e non un'altra ---
   Parte al primo tasto (i browser non lasciano suonare da soli), si
   spegne con M, e resta la stessa per tutta la partita: è la colonna
   sonora della memoria, non un jingle. */
var AUD=null,AUD_ON=false,AUD_ERR=false;
function audioBoot(){
  if(AUD)return AUD;
  try{
    AUD=new Audio("../RadioKaoSs/tg%20del%20cosmo/tg"+MEM+".MP3");
    AUD.loop=true;AUD.volume=0.34;AUD.preload="auto";
    AUD.onerror=function(){AUD_ERR=true;AUD_ON=false;};
  }catch(e){AUD_ERR=true;AUD=null;}
  return AUD;
}
function audioPlay(){
  var a=audioBoot(),p;
  if(!a)return;
  try{
    p=a.play();
    if(p&&p.catch)p.catch(function(){AUD_ON=false;});
    AUD_ON=true;
  }catch(e){AUD_ON=false;}
}
function audioToggle(){
  var a=audioBoot();
  if(!a)return;
  if(AUD_ON){try{a.pause();}catch(e){}AUD_ON=false;toast("radio spenta · tg"+MEM+".MP3 in pausa",2.4);return;}
  audioPlay();
  toast(AUD_ON?("radio accesa · tg"+MEM+".MP3"):("nastro tg"+MEM+".MP3 non parte"),2.4);
}
(function(){
  function once(){
    audioPlay();
    removeEventListener("keydown",once);
    removeEventListener("pointerdown",once);
    removeEventListener("touchstart",once);
  }
  addEventListener("keydown",once);addEventListener("pointerdown",once);addEventListener("touchstart",once);
})();

var cv=document.getElementById("cv"),ctx=cv.getContext("2d");
var VW=1024,VH=600,scale=1,offX=0,offY=0;
function resize(){
  cv.width=innerWidth;cv.height=innerHeight;
  scale=Math.min(cv.width/VW,cv.height/VH);
  offX=(cv.width-VW*scale)/2;offY=(cv.height-VH*scale)/2;
}
addEventListener("resize",resize);resize();
function clamp(v,a,b){return v<a?a:v>b?b:v}
function lerp(a,b,k){return a+(b-a)*k}
function rgba(c,a){if(!c||c.charAt(0)!=="#")return c;var n=parseInt(c.slice(1),16);return "rgba("+((n>>16)&255)+","+((n>>8)&255)+","+(n&255)+","+a+")"}
function rnd(i){var v=Math.sin(i*127.1+311.7)*43758.5453;return v-Math.floor(v)}
function txt(s,x,y,sz,col,al,w){ctx.font=(w||700)+" "+sz+"px ui-monospace,monospace";ctx.fillStyle=col;ctx.textAlign=al||"left";ctx.textBaseline="alphabetic";ctx.fillText(s,x,y)}
/* ---- tastiera e mouse -------------------------------------- */
var keys={},mouse={x:VW/2,y:VH/2,down:false};
function kn(e){var k=e.key.toLowerCase();if(k===" ")k="space";return k}
addEventListener("keydown",function(e){
  var k=kn(e);keys[k]=true;
  if(["space","arrowup","arrowdown","arrowleft","arrowright"].indexOf(k)>=0)e.preventDefault();
  if(k==="1"&&SLOTS.length>0)WI=0;
  if(k==="2"&&SLOTS.length>1)WI=1;
  if(k==="q")WI=(WI+1)%SLOTS.length;
  if(k==="m")audioToggle();
  if(k==="escape"||k==="esc") returnToCosmo();
  if(k==="r"&&G&&G.ended&&G.daisy>0) reset();
  if(G&&G.win>0.7){ returnToCosmo(); return; }
});
addEventListener("keyup",function(e){keys[kn(e)]=false;});
function tw(e){return {x:(e.clientX-offX)/scale,y:(e.clientY-offY)/scale}}
addEventListener("mousemove",function(e){var p=tw(e);mouse.x=p.x;mouse.y=p.y;});
addEventListener("mousedown",function(e){if(e.button===0)mouse.down=true;if(G&&G.win>0.7){returnToCosmo();return;}if(G&&G.ended&&G.daisy>0)reset();});
addEventListener("mouseup",function(e){if(e.button===0)mouse.down=false;});
addEventListener("blur",function(){mouse.down=false;keys={};});
function hitKey(a,b){return !!keys[a]||!!keys[b]}
/* ---- memoria: le due armi che scendono dal muro ------------ */
var SAVE_M="cosmo_memorie_v1",SAVE_A="cosmo_arsenal_v1";
function loadJ(k){try{var r=localStorage.getItem(k);return r?JSON.parse(r):{}}catch(e){return {}}}
function saveJ(k,o){try{localStorage.setItem(k,JSON.stringify(o));}catch(e){}}
var WDEF={
  pistol:{id:"pistol",name:"LA PISTOLA",cd:0.22,spd:1500,dmg:34,spread:0.012,n:1,col:"#ffd88a",life:0.95,recoil:64,hype:"nove colpi e un fischio"},
  smg:{id:"smg",name:"IL MITRA",cd:0.075,spd:1320,dmg:13,spread:0.085,n:1,col:"#ffc46a",life:0.8,recoil:34,hype:"caricatore storto"},
  flame:{id:"flame",name:"IL LANCIAFIAMME",cd:0.038,spd:470,dmg:2.6,spread:0.19,n:1,col:"#ff9a3c",life:0.40,recoil:12,flame:true,hype:"due bombole e un tubo"},
  sword:{id:"sword",name:"LA SPADA",cd:0.36,dmg:74,range:132,col:"#dfe7ec",melee:true,recoil:0,hype:"lama opaca, filo mai usato"}
};
var ARS=loadJ(SAVE_A),SLOTS=[],WI=0;
(function(){
  var sel=(ARS&&ARS.sel)||[],i,id;
  for(i=0;i<sel.length;i++){id=sel[i];if(WDEF[id]&&SLOTS.indexOf(id)<0)SLOTS.push(id);}
  if(!SLOTS.length&&ARS&&ARS.weapons){for(id in ARS.weapons){if(WDEF[id]&&SLOTS.length<2)SLOTS.push(id);}}
  if(!SLOTS.length)SLOTS.push("pistol");
})();
function curW(){return WDEF[SLOTS[WI]]||WDEF.pistol}
/* ============================================================
   LA MAPPA — 5200 x 2400. Non un corridoio: tre quote.
   tetti (≈940-1250) · strada (1580) · fogne (2280)
   ============================================================ */
var W=5200,H=2400,GY=1580,SY=2280;
var SOL=[],LAD=[],DECO=[],ROOFS=[];
function box(x,y,w,h,k){var s={x:x,y:y,w:w,h:h,k:k||"stone"};SOL.push(s);return s}
function ladder(x,y0,y1){LAD.push({x:x,y0:y0,y1:y1})}
/* la strada: tre isolati e due voragini che portano giu'
   (lastre spesse 120: sotto c'e' il volume delle fogne) */
box(-40,GY,1540,120,"street");
box(1700,GY,1600,120,"street");
box(3520,GY,1720,120,"street");
/* il fondo delle fogne: tutta la larghezza */
box(-40,SY,5280,180,"sewer");
/* i tetti, da sinistra a destra, sempre piu' in alto */
(function(){
  var R=[[300,1240,620],[1060,1080,520],[1920,1230,600],[2720,1000,500],[3720,1250,460],[4320,940,600]],i;
  for(i=0;i<R.length;i++){ROOFS.push({x:R[i][0],y:R[i][1],w:R[i][2]});box(R[i][0],R[i][1],R[i][2],26,"roof");}
})();
/* casse e rottami: gradini per arrivare dove non si arriva */
box(2580,1510,190,70,"crate");
box(1180,1010,70,70,"crate");
box(4560,880,70,60,"crate");
box(3620,1520,150,60,"crate");
/* le scale: una per tetto, tutte che partono dalla strada */
ladder(760,GY,1240);
ladder(1300,GY,1080);
ladder(2300,GY,1230);
ladder(2900,GY,1000);
ladder(3900,GY,1250);
ladder(4500,GY,940);
ladder(1000,SY,GY);
ladder(3120,SY,GY);
ladder(4900,SY,GY);
/* le facciate dietro: non si attraversano, si guardano */
(function(){
  var i;
  for(i=0;i<30;i++){
    var bx=-200+i*200,bw=110+Math.floor(rnd(i*1.7)*90);
    var bh=170+Math.floor(rnd(i*3.1)*240);
    DECO.push({x:bx,w:bw,h:bh,seed:i,top:GY-bh});
  }
})();
var EXIT={x:MZ.exit.x,y:MZ.exit.y},CASS={x:MZ.cass.x,y:MZ.cass.y,taken:false};
var SPAWN=[
  {t:"daisy",x:980,y:GY},{t:"daisy",x:2180,y:GY},{t:"soldier",x:2520,y:GY},
  {t:"daisy",x:3860,y:GY},{t:"soldier",x:4020,y:1250},{t:"daisy",x:3480,y:GY},
  {t:"daisy",x:2500,y:SY},{t:"daisy",x:4300,y:SY},{t:"soldier",x:4700,y:SY},
  {t:"drone",x:1500,y:1300},{t:"drone",x:3000,y:1120},{t:"drone",x:4100,y:1140}
];
/* più la memoria è alta, più gente per strada: si aggiungono
   comparse, non si riscrive la mappa */
(function(){
  if(MZ.foes<=1)return;
  var i,add=[],want=Math.round((MZ.foes-1)*6);
  for(i=0;i<SPAWN.length&&add.length<want;i++){
    if(i%2)continue;
    add.push({t:SPAWN[i].t==="daisy"?"soldier":"drone",
      x:clamp(SPAWN[i].x+150,60,W-60),y:SPAWN[i].y});
  }
  SPAWN=SPAWN.concat(add);
})();
var NOTE_DEF=[
  {id:"m12",x:1240,y:1050,l:"LA NOTA DEL FOGLIO",q:"«il mondo non e' fatto di stanze, e' fatto di pagine»",
    b:"«Il mondo non e' fatto di stanze, e' fatto di pagine. Stanotte ho contato le mie: undici, dodici, tredici — la quattordici non c'era. Chi tiene il quaderno sa dove finiscono. Se le trovi non strapparle: si portano al museo, che la le ricuciono nella tela.»\n\nSotto, a matita, una data che non e' una data: 3013."},
  {id:"m11",x:3130,y:2250,l:"LA NOTA DELL'OCCHIO",q:"«l'occhio nel cielo non guarda: aspetta»",
    b:"«L'occhio nel cielo non guarda: aspetta. Quando scende il conto e' di quaranta secondi e non si ferma. Non correre dritto — l'occhio ti sta addosso come una mano, e le scale e i tetti servono a questo. Il furgone e' la sola porta che resta aperta.»\n\nIl foglio e' umido: e' stato sotto la pioggia rossa."},
  {id:"m13",x:4520,y:912,l:"LA NOTA DELLA MARGHERITA",q:"«chi non ballava diventava margherita»",
    b:"«Chi non ballava diventava margherita. Non e' una metafora: e' una regola, e le regole qui non si spiegano, si ballano. Il campo fuori dal pozzo e' pieno di facce gialle girate verso il sole. Io ne ho conosciute tre, e una mi chiamava per nome.»\n\nLa scrittura cambia a meta' riga: piu' grande, come di chi scrive in piedi."}
];
/* le pagine che questa memoria si porta dietro: ogni cassetta ha le
   sue, e il libro del computer di bordo le ricopia una per una */
NOTE_DEF=NOTE_DEF.filter(function(n){return MZ.notes.indexOf(n.id)>=0;});
/* ============================================================
   STATO
   ============================================================ */
var P={x:470,y:GY,vx:0,vy:0,dir:1,phase:0,speed:0,state:"idle",ground:true,
  onLadder:false,invuln:0,blink:0,earA:0,earV:0,ear2A:0,ear2V:0,tailA:0,tailV:0,
  bodyY:0,bodyV:0,cd:0,swing:0,recoil:0,aim:0,muzzle:0,w:46,h:92,scale:1,build:1,line:3,dead:false};
var camx=0,camy=0,time=0,dt=0;
var bul=[],eb=[],parts=[],ents=[],notes=[],notesTaken={},stars=[];
var G={intro:1.6,cass:false,eyeOn:false,eyeT:0,eyeMax:MZ.timer,eyeBlink:0,hp:MZ.hp,maxhp:MZ.hp,
  over:0,win:0,daisy:0,daisyT:0,msg:"",msgT:0,shake:0,flash:0,seen:0,fade:0,ended:false,eyeX:470,eyeY:120};
function toast(s,tm){G.msg=s;G.msgT=tm||3.2}
(function(){var i;for(i=0;i<160;i++)stars.push({x:rnd(i*2.3)*W,y:rnd(i*5.1)*GY,r:.6+rnd(i*7.7)*1.5,s:.3+rnd(i*3.3)*.9});})();
/* ---- collisioni -------------------------------------------- */
function hitsAt(x,y,w,h){
  var bx=x-w/2,by=y-h,i,s;
  for(i=0;i<SOL.length;i++){
    s=SOL[i];
    if(bx<s.x+s.w&&bx+w>s.x&&by<s.y+s.h&&by+h>s.y)return s;
  }
  return null;
}
function ladderAt(x,y){
  var i,l;
  for(i=0;i<LAD.length;i++){
    l=LAD[i];
    if(Math.abs(x-l.x)<36&&y<=l.y0+14&&y>=l.y1-14)return l;
  }
  return null;
}
function groundBelow(x,y){
  var i,s,best=null;
  for(i=0;i<SOL.length;i++){
    s=SOL[i];
    if(x>s.x-4&&x<s.x+s.w+4&&s.y>=y-6&&(!best||s.y<best.y))best=s;
  }
  return best;
}
/* ---- si riparte -------------------------------------------- */
function reset(){
  P.x=470;P.y=GY;P.vx=0;P.vy=0;P.dir=1;P.state="idle";P.ground=true;P.onLadder=false;
  P.invuln=0;P.cd=0;P.swing=0;P.recoil=0;P.dead=false;P.phase=0;P.speed=0;
  bul.length=0;eb.length=0;parts.length=0;notesTaken={};
  CASS.taken=false;
  G.maxhp=MZ.hp;G.eyeMax=MZ.timer;
  G.cass=false;G.eyeOn=false;G.eyeT=0;G.hp=G.maxhp;G.over=0;G.win=0;G.daisy=0;G.daisyT=0;G.ended=false;
  G.eyeX=P.x;G.eyeY=120;
  G.fade=0;G.shake=0;G.flash=0;G.intro=1.6;
  ents.length=0;
  (function(){
    var i,d;
    for(i=0;i<SPAWN.length;i++){
      d=SPAWN[i];
      ents.push({t:d.t,x:d.x,y:d.y,bx:d.x,by:d.y,hp:d.t==="daisy"?46:d.t==="soldier"?58:40,
        max:d.t==="daisy"?46:d.t==="soldier"?58:40,dead:false,fire:1+rnd(i*2.1)*1.4,
        ph:rnd(i*3.3)*6.3,hit:0,vx:0,dir:-1,bob:0});
    }
  })();
  notes.length=0;
  (function(){var i;for(i=0;i<NOTE_DEF.length;i++)notes.push({id:NOTE_DEF[i].id,x:NOTE_DEF[i].x,y:NOTE_DEF[i].y,l:NOTE_DEF[i].l,q:NOTE_DEF[i].q,got:false});})();
  camx=clamp(P.x-VW/2,0,W-VW);camy=clamp(P.y-VH*0.6,0,H-VH);
}
/* ============================================================
   IL CONIGLIO IN MOVIMENTO — gravita', scale, coyote time
   ============================================================ */
var coyote=0;
function updatePlayer(){
  var walk=430,run=690,acc=3600;
  if(P.dead)return;
  var want=(hitKey("d","arrowright")?1:0)-(hitKey("a","arrowleft")?1:0);
  var up=hitKey("w","arrowup"),down=hitKey("s","arrowdown");
  var lad=ladderAt(P.x,P.y);
  P.invuln=Math.max(0,P.invuln-dt);
  P.cd=Math.max(0,P.cd-dt);
  P.swing=Math.max(0,P.swing-dt);
  P.recoil=Math.max(0,P.recoil-dt*4);
  P.muzzle=Math.max(0,P.muzzle-dt);
  P.blink-=dt;
  if(P.blink<-0.4&&Math.random()<dt*0.4)P.blink=0.14;
  /* --- la scala --- */
  if(P.onLadder&&!lad)P.onLadder=false;
  if(P.onLadder){
    P.x=lerp(P.x,lad.x,0.35);
    P.vy=up?-300:down?300:0;
    P.y+=P.vy*dt;
    if(P.y<=lad.y1&&!down){P.y=lad.y1;P.onLadder=false;P.vy=0;P.ground=true;}
    else if(P.y>=lad.y0&&!up){P.y=lad.y0;P.onLadder=false;P.vy=0;P.ground=true;}
    if(hitKey("space")){P.onLadder=false;P.vy=-520;P.ground=false;}
    P.phase+=dt*3;P.state="climb";P.speed=0;P.vx=0;
    return;
  }
  if(lad&&(up||down)){P.onLadder=true;return;}
  /* --- passo --- */
  if(want!==0){P.vx+=want*acc*dt;P.dir=want;}
  else P.vx-=P.vx*Math.min(1,13*dt);
  var lim=keys["shift"]?run:walk;
  P.vx=clamp(P.vx,-lim,lim);
  var nx=P.x+P.vx*dt,s=hitsAt(nx,P.y,P.w,P.h);
  if(s){nx=P.vx>0?s.x-P.w/2-0.2:s.x+s.w+P.w/2+0.2;P.vx=0;}
  P.x=clamp(nx,26,W-26);
  /* --- salto --- */
  if(P.ground)coyote=0.11;else coyote=Math.max(0,coyote-dt);
  if(hitKey("space")&&coyote>0){P.vy=-880;P.ground=false;coyote=0;}
  P.vy=Math.min(P.vy+2150*dt,1600);
  var ny=P.y+P.vy*dt,sy=hitsAt(P.x,ny,P.w,P.h);
  P.ground=false;
  if(sy){
    if(P.vy>0){ny=sy.y;P.ground=true;}
    else{ny=sy.y+sy.h+P.h;P.vy=0;}
  }
  if(ny>H-30){ny=H-30;P.ground=true;}
  P.y=ny;
  /* --- lo stato del corpo --- */
  P.speed=Math.abs(P.vx);
  if(!P.ground)P.state="jump";
  else if(P.speed>500)P.state="run";
  else if(P.speed>14)P.state="walk";
  else P.state="idle";
  P.phase+=(Math.min(P.speed,700)/70)*dt*7.5;
  if(P.speed<14)P.phase+=dt*0.7;
  var bounce=(P.state==="walk"||P.state==="run")?Math.sin(P.phase*2)*0.16:0;
  var targetEar=-0.4*P.dir*(P.speed/690)+bounce*0.5;
  P.earV+=(targetEar-P.earA)*46*dt;P.earV*=Math.pow(0.02,dt);P.earA+=P.earV*dt;
  P.ear2V+=(targetEar*1.35-P.ear2A)*38*dt-P.earV*0.3;P.ear2V*=Math.pow(0.02,dt);P.ear2A+=P.ear2V*dt;
  P.tailV+=(-P.dir*0.25*(0.3+P.speed/690)-P.tailA)*30*dt;P.tailV*=Math.pow(0.05,dt);P.tailA+=P.tailV*dt;
  var tb=Math.abs(Math.sin(P.phase*2))*(P.speed>14?4:0);
  P.bodyV+=(tb-P.bodyY)*90*dt;P.bodyV*=Math.pow(0.01,dt);P.bodyY+=P.bodyV*dt;
}
function aimAngle(){
  var ex=P.x-camx,ey=P.y-56-camy;
  return Math.atan2(mouse.y-ey,mouse.x-ex);
}
/* ============================================================
   LE ARMI — sparano davvero, ognuna a modo suo
   ============================================================ */
function baseAng(){
  var a=aimAngle();
  P.dir=Math.cos(a)>=0?1:-1;
  return a;
}
function fire(){
  if(P.cd>0||P.dead||G.ended||G.daisy>0)return;
  var w=curW(),a=baseAng(),i,sp;
  if(w.melee){
    P.swing=0.26;P.cd=w.cd;
    for(i=0;i<ents.length;i++){
      var e=ents[i];
      if(e.dead)continue;
      var dx=e.x-P.x,dy=(e.y-(e.t==="drone"?34:48))-(P.y-56);
      var d=Math.sqrt(dx*dx+dy*dy);
      if(d<w.range){
        var da=Math.atan2(dy,dx)-a;
        while(da>Math.PI)da-=6.283;while(da<-Math.PI)da+=6.283;
        if(Math.abs(da)<1.15)hurtEnemy(e,w.dmg,d.x||P.x,d.y||P.y);
      }
    }
    for(i=0;i<12;i++)parts.push({x:P.x+Math.cos(a)*40,y:P.y-56+Math.sin(a)*40,
      vx:Math.cos(a)*(160+Math.random()*260)+(Math.random()-0.5)*120,
      vy:Math.sin(a)*(160+Math.random()*260)+(Math.random()-0.5)*120,
      life:0.26,max:0.26,col:"#dfe7ec",r:1.5});
    G.shake=Math.min(7,G.shake+2.4);
    return;
  }
  P.cd=w.cd;P.recoil=1;P.muzzle=0.07;
  for(i=0;i<(w.n||1);i++){
    sp=a+(Math.random()-0.5)*w.spread*2;
    bul.push({x:P.x+Math.cos(sp)*36,y:P.y-56+Math.sin(sp)*36,
      vx:Math.cos(sp)*w.spd,vy:Math.sin(sp)*w.spd,dmg:w.dmg,life:w.life,
      col:w.col,flame:!!w.flame,r:w.flame?11:2.6});
  }
  if(!w.flame){
    for(i=0;i<5;i++)parts.push({x:P.x+Math.cos(a)*38,y:P.y-56+Math.sin(a)*38,
      vx:Math.cos(a)*(140+Math.random()*190)+(Math.random()-0.5)*90,
      vy:Math.sin(a)*(140+Math.random()*190)+(Math.random()-0.5)*90,
      life:0.2,max:0.2,col:"#ffd88a",r:1.5});
  }
  G.shake=Math.min(6,G.shake+(w.recoil||0)*0.03+0.6);
}
function updateBullets(){
  var i,j,b,e,dx,dy,gone;
  for(i=bul.length-1;i>=0;i--){
    b=bul[i];
    b.x+=b.vx*dt;b.y+=b.vy*dt;b.life-=dt;
    if(b.flame){
      b.vx*=Math.pow(0.05,dt);b.vy=b.vy*Math.pow(0.05,dt)-120*dt;
      if(Math.random()<dt*40)parts.push({x:b.x,y:b.y,vx:(Math.random()-0.5)*40,vy:-40-Math.random()*60,life:0.4,max:0.4,col:"#ff9a3c",r:Math.random()*7+3});
    }
    if(b.life<=0||b.x<-60||b.x>W+60||b.y<-60||b.y>H+60){bul.splice(i,1);continue;}
    if(!b.flame&&hitsAt(b.x,b.y,7,7)){
      for(j=0;j<5;j++)parts.push({x:b.x,y:b.y,vx:(Math.random()-0.5)*260,vy:(Math.random()-0.5)*260,life:0.24,max:0.24,col:b.col,r:1.6});
      bul.splice(i,1);continue;
    }
    gone=false;
    for(j=0;j<ents.length;j++){
      e=ents[j];
      if(e.dead)continue;
      dx=b.x-e.x;dy=b.y-(e.y-(e.t==="drone"?34:48));
      if(dx*dx+dy*dy<42*42){hurtEnemy(e,b.dmg,b.x,b.y);bul.splice(i,1);gone=true;break;}
    }
    }
  for(i=eb.length-1;i>=0;i--){
    b=eb[i];
    b.x+=b.vx*dt;b.y+=b.vy*dt;b.life-=dt;
    if(b.life<=0){eb.splice(i,1);continue;}
    if(hitsAt(b.x,b.y,7,7)){
      for(j=0;j<3;j++)parts.push({x:b.x,y:b.y,vx:(Math.random()-0.5)*160,vy:(Math.random()-0.5)*160,life:0.2,max:0.2,col:"#ff5a5a",r:1.4});
      eb.splice(i,1);continue;
    }
    dx=b.x-P.x;dy=b.y-(P.y-52);
    if(dx*dx+dy*dy<34*34){eb.splice(i,1);hurtP(1);}
  }
}
function hurtEnemy(e,dmg,fx,fy){
  e.hp-=dmg;e.hit=0.16;
  var n=e.t==="drone"?6:5,i;
  for(i=0;i<n;i++)parts.push({x:fx||e.x,y:fy||(e.y-46),vx:(Math.random()-0.5)*320,vy:(Math.random()-0.5)*320,life:0.34,max:0.34,col:e.t==="daisy"?"#f5f3e6":"#ff6a4a",r:2+Math.random()*2.4});
  if(e.hp<=0&&!e.dead){
    e.dead=true;
    for(i=0;i<18;i++)parts.push({x:e.x,y:e.y-(e.t==="drone"?34:44),vx:(Math.random()-0.5)*420,vy:(Math.random()-0.5)*420,life:0.7,max:0.7,col:e.t==="daisy"?"#f7f4e4":"#ff7a4a",r:2+Math.random()*3});
    G.shake=Math.min(8,G.shake+3);
  }
}
function hurtP(n){
  if(P.invuln>0||P.dead||G.win>0)return;
  G.hp-=n;P.invuln=0.9;G.shake=Math.min(10,G.shake+3.4);G.flash=Math.max(G.flash,0.42);
  if(G.hp<=0){G.hp=0;startDaisy("TI HANNO PRESO");}
}
/* ============================================================
   LORO — margherite, soldati, droni
   ============================================================ */
function shootAt(e,spd){
  var oy=e.t==="drone"?34:44;
  var dx=P.x-e.x,dy=(P.y-52)-(e.y-oy),a=Math.atan2(dy,dx)+(Math.random()-0.5)*0.17;
  eb.push({x:e.x+Math.cos(a)*22,y:e.y-oy+Math.sin(a)*22,
    vx:Math.cos(a)*spd,vy:Math.sin(a)*spd,life:3.2,col:"#ff5a5a"});
  for(var i=0;i<3;i++)parts.push({x:e.x+Math.cos(a)*22,y:e.y-oy+Math.sin(a)*22,
    vx:Math.cos(a)*90+(Math.random()-0.5)*90,vy:Math.sin(a)*90+(Math.random()-0.5)*90,
    life:0.18,max:0.18,col:"#ffb37a",r:1.6});
}
function updateEnemies(){
  var i,e,dx,dy,d,act;
  for(i=0;i<ents.length;i++){
    e=ents[i];
    e.ph+=dt;e.hit=Math.max(0,e.hit-dt);
    if(e.dead)continue;
    dx=P.x-e.x;dy=P.y-e.y;d=Math.sqrt(dx*dx+dy*dy);
    act=d<780&&!P.dead&&G.daisy<=0;
    if(e.t==="daisy"){
      if(act&&Math.abs(dy)<170){e.dir=dx>=0?1:-1;e.x+=e.dir*116*dt;}
      else e.x+=Math.sin(e.ph*0.7)*26*dt;
      e.x=clamp(e.x,e.bx-160,e.bx+160);
      e.y=e.by+Math.sin(e.ph*3.2)*2.5;
      if(d<54&&Math.abs(dy)<80)hurtP(1);
    }else if(e.t==="soldier"){
      e.fire-=dt;
      if(act&&Math.abs(dy)<280&&Math.abs(dx)<900){
        e.dir=dx>=0?1:-1;
        if(e.fire<=0){e.fire=1.9+rnd(i*1.3)*0.9;shootAt(e,300);}
      }
    }else{
      if(act){
        e.x+=Math.sign(dx)*88*dt;
        e.x=clamp(e.x,e.bx-300,e.bx+300);
      }
      e.y=e.by+Math.sin(e.ph*1.6)*18;
      e.fire-=dt;
      if(act&&e.fire<=0&&d<660){e.fire=2.3+rnd(i*3.7)*1.0;shootAt(e,260);}
      if(d<50)hurtP(1);
    }
  }
}
/* ============================================================
   COSE DA PRENDERE — note, cassetta, furgone
   ============================================================ */
function takeNote(n){
  n.got=true;
  var a=loadJ(SAVE_A);
  a.pages=a.pages||{};a.pages[n.id]=(a.pages[n.id]||0)+1;
  a.seen=a.seen||{};a.seen[n.id]=true;
  /* la nota si porta dietro quello che c'è scritto: etichetta, frase e
     il foglio intero. Il museo non ha la strada sotto mano, e senza
     questo nel computer di bordo resterebbe solo un numero. */
  a.noteText=a.noteText||{};
  a.noteText[n.id]={l:n.l,q:n.q,b:n.b||""};
  saveJ(SAVE_A,a);
  toast("PAGINA DEL LIBRO · "+n.l+" — ricopiata nel computer di bordo",4.6);
  G.flash=0.3;
  for(var i=0;i<22;i++)parts.push({x:n.x,y:n.y-14,vx:(Math.random()-0.5)*230,vy:-Math.random()*260,life:0.9,max:0.9,col:"#e8dcc0",r:2+Math.random()*2});
}
function winMission(){
  if(G.win>0||G.daisy>0)return;
  G.win=0.0001;G.eyeOn=false;G.flash=0.7;
  var k=String(MEM);
  var a=loadJ(SAVE_A);
  a.missions=a.missions||{};a.missions[k]=true;
  a.videos=a.videos||{};a.videos[k]=true;
  saveJ(SAVE_A,a);
  var m=loadJ(SAVE_M);
  m.memorieSbloccate=Math.max(MEM,m.memorieSbloccate||0);
  saveJ(SAVE_M,m);
}
function startDaisy(reason){
  if(G.daisy>0||G.win>0)return;
  G.daisy=0.0001;G.daisyT=0;P.dead=true;P.vx=0;P.vy=0;
  G.reason=reason||"";G.shake=12;G.flash=0.9;G.eyeOn=false;
}
function updatePickups(){
  var i,n;
  for(i=0;i<notes.length;i++){
    n=notes[i];
    if(n.got)continue;
    if(Math.abs(P.x-n.x)<62&&Math.abs(P.y-n.y)<100)takeNote(n);
  }
  if(!CASS.taken&&Math.abs(P.x-CASS.x)<86&&Math.abs(P.y-CASS.y)<110){
    CASS.taken=true;G.cass=true;G.eyeOn=true;G.eyeT=MZ.timer;
    G.flash=0.85;G.shake=9;
    toast("LA CASSETTA E' TUA — TORNA AL FURGONE PRIMA CHE L'OCCHIO TI VEDA · "+fmt(MZ.timer),5);
  }
  if(G.cass&&G.eyeOn&&Math.abs(P.x-EXIT.x)<115&&Math.abs(P.y-EXIT.y)<150)winMission();
}
function updateEye(){
  /* L'occhio nel cielo segue dolcemente il giocatore attraverso la mappa */
  G.eyeX=lerp(G.eyeX,P.x,Math.min(1,dt*2.2));
  G.eyeY=lerp(G.eyeY,120+Math.sin(time*1.5)*14,Math.min(1,dt*2.0));
  if(!G.eyeOn)return;
  G.eyeT-=dt;
  if(G.eyeT<=10){
    G.eyeBlink-=dt;
    if(G.eyeBlink<-0.5&&Math.random()<dt*3)G.eyeBlink=0.16;
  }
  if(G.eyeT<=0){G.eyeT=0;G.eyeOn=false;startDaisy("L'OCCHIO TI HA VISTO");}
}
function updateParts(){
  var i,p;
  for(i=parts.length-1;i>=0;i--){
    p=parts[i];
    p.x+=p.vx*dt;p.y+=p.vy*dt;
    p.vy+=900*dt;p.vx*=Math.pow(0.4,dt);
    p.life-=dt;
    if(p.life<=0)parts.splice(i,1);
  }
}
/* ============================================================
   DISEGNO — prima il cielo, poi le tre quote
   ============================================================ */
function camTarget(){
  return {x:clamp(P.x-VW/2+(mouse.x-VW/2)*0.13,0,W-VW),y:clamp(P.y-VH*0.6,0,H-VH)};
}
function updateCam(){
  var t=camTarget();
  camx=lerp(camx,t.x,Math.min(1,dt*7));
  camy=lerp(camy,t.y,Math.min(1,dt*6));
}
function skyline(par,baseY,hs,col,windows){
  var i,d,x,y,h,wy,wx;
  for(i=0;i<DECO.length;i++){
    d=DECO[i];
    x=d.x-camx*par;
    if(x>VW+240||x+d.w<-240)continue;
    y=baseY-camy*par*0.55;
    h=d.h*hs;
    ctx.fillStyle=col;
    ctx.fillRect(x,y-h,d.w,h);
    ctx.fillStyle="rgba(255,255,255,0.035)";
    ctx.fillRect(x,y-h,d.w,1.5);
    if(windows){
      for(wy=0;wy<Math.floor(h/46);wy++){
        for(wx=0;wx<Math.floor(d.w/26);wx++){
          if(rnd(d.seed*7.1+wy*3.3+wx*1.7)<0.62)continue;
          ctx.fillStyle=rnd(d.seed+wy+wx)<0.5?"rgba(255,204,132,0.5)":"rgba(160,214,236,0.35)";
          ctx.fillRect(x+9+wx*26,y-h+16+wy*46,7,11);
        }
      }
    }
  }
}
function drawSky(){
  var g=ctx.createLinearGradient(0,0,0,VH);
  g.addColorStop(0,"#08131b");g.addColorStop(.42,"#0d2029");g.addColorStop(1,"#050a0d");
  ctx.fillStyle=g;ctx.fillRect(0,0,VW,VH);
  var i,s,sx,sy;
  for(i=0;i<stars.length;i++){
    s=stars[i];
    sx=((s.x-camx*0.12)%VW+VW)%VW;
    sy=((s.y-camy*0.12)%VH+VH)%VH;
    ctx.globalAlpha=0.22+0.5*Math.abs(Math.sin(time*s.s+i));
    ctx.fillStyle="#cfe0ea";
    ctx.fillRect(sx,sy,s.r,s.r);
  }
  ctx.globalAlpha=1;
  /* il sole bianco, basso: brucia sempre */
  var sxp=VW*0.74-camx*0.05,syp=150-camy*0.06;
  var sg=ctx.createRadialGradient(sxp,syp,4,sxp,syp,190);
  sg.addColorStop(0,"rgba(255,238,205,0.5)");
  sg.addColorStop(.35,"rgba(220,150,80,0.12)");
  sg.addColorStop(1,"rgba(0,0,0,0)");
  ctx.fillStyle=sg;ctx.fillRect(sxp-200,syp-200,400,400);
  ctx.fillStyle="rgba(255,246,226,0.72)";
  ctx.beginPath();ctx.arc(sxp,syp,23,0,6.3);ctx.fill();
  skyline(0.13,VH*0.80,0.52,"#0a1a22",false);
  skyline(0.30,VH*0.92,0.72,"#0d2029",true);
  skyline(0.58,VH*1.04,0.95,"#122833",true);
  /* la nebbia bassa */
  ctx.globalAlpha=.07;ctx.fillStyle="#b9c6cc";
  for(i=0;i<3;i++)ctx.fillRect(0,VH*0.55+i*74+Math.sin(time*.35+i)*9,VW,46);
  ctx.globalAlpha=1;
  /* i cavi penzolanti */
  ctx.strokeStyle="rgba(5,9,11,0.85)";ctx.lineWidth=2;
  for(i=0;i<4;i++){
    var cx0=((i*320-camx*0.28)%(VW+320)+(VW+320))%(VW+320)-160;
    var cy0=36-camy*0.16+i*20;
    if(cy0>VH*0.72)continue;
    ctx.beginPath();ctx.moveTo(cx0,cy0);
    ctx.quadraticCurveTo(cx0+150,cy0+130+(i%2)*40,cx0+320,cy0-18);ctx.stroke();
  }
  /* la cenere che cade, sempre */
  ctx.fillStyle="rgba(216,206,188,0.5)";
  for(i=0;i<70;i++){
    var ax=((i*137.7+time*16)%(VW+120)+(VW+120))%(VW+120)-60;
    var ay=((i*97.3+time*30-camy*0.2)%(VH+60)+(VH+60))%(VH+60)-30;
    ctx.fillRect(ax,ay,1.7,1.7);
  }
}
/* ---- le tre quote ------------------------------------------ */
function drawStreet(s){
  var x=s.x-camx,y=s.y-camy,w=s.w,h=s.h;
  if(y>VH||y+h<0)return;
  ctx.fillStyle="#0b1419";ctx.fillRect(x,y,w,h);
  ctx.fillStyle="#16262e";ctx.fillRect(x,y,w,10);
  ctx.fillStyle="#22343d";ctx.fillRect(x,y,w,3);
  /* asfalto granuloso, scorre col mondo */
  var i;
  ctx.fillStyle="rgba(120,148,160,0.10)";
  for(i=0;i<w/34;i++){
    var gx=x+i*34,gi=Math.floor((s.x+i*34)/34);
    if(gi%2)continue;
    ctx.fillRect(gx,y+22+((gi*37)%60),12,2);
  }
  ctx.fillStyle="rgba(0,0,0,0.5)";
  for(i=0;i<w/120;i++)ctx.fillRect(x+i*120+40,y-1,52,3);
  /* la faccia di sotto: la strada e' spessa, non un foglio */
  ctx.fillStyle="#070d0f";ctx.fillRect(x,y+h,w,VH);
  ctx.fillStyle="rgba(120,148,160,0.06)";
  var ry;
  for(ry=y+h+18;ry<VH;ry+=26)ctx.fillRect(x,ry,w,1);
  ctx.fillStyle="#050a0c";ctx.fillRect(x,y+h-5,w,5);
  ctx.fillStyle="rgba(120,148,160,0.14)";ctx.fillRect(x,y+h,w,1.5);
  /* i lampioni al sodio: la strada respirata dalla v1 */
  var li,lx,top;
  for(li=0;li<Math.ceil(w/420);li++){
    lx=x+150+li*420;
    if(lx<x-40||lx>x+w+40)continue;
    top=y-262;
    ctx.fillStyle="#132229";ctx.fillRect(lx-2,top,5,262);
    ctx.fillStyle="#1c3038";ctx.fillRect(lx-15,top-4,32,6);
    ctx.globalCompositeOperation="lighter";
    var cone=ctx.createLinearGradient(0,top,0,y);
    cone.addColorStop(0,"rgba(255,206,132,0.22)");
    cone.addColorStop(.55,"rgba(255,186,100,0.09)");
    cone.addColorStop(1,"rgba(255,160,60,0)");
    ctx.fillStyle=cone;
    ctx.beginPath();ctx.moveTo(lx-11,top);ctx.lineTo(lx+13,top);
    ctx.lineTo(lx+96,y+40);ctx.lineTo(lx-92,y+40);ctx.closePath();ctx.fill();
    var bulb=ctx.createRadialGradient(lx+1,top+2,1,lx+1,top+2,44);
    bulb.addColorStop(0,"rgba(255,236,196,0.85)");
    bulb.addColorStop(1,"rgba(255,170,70,0)");
    ctx.fillStyle=bulb;ctx.beginPath();ctx.arc(lx+1,top+2,44,0,6.3);ctx.fill();
    ctx.globalCompositeOperation="source-over";
    ctx.fillStyle="rgba(255,226,170,0.9)";ctx.fillRect(lx-4,top+1,10,4);
  }
}
function drawSewerFloor(s){
  var x=s.x-camx,y=s.y-camy,w=s.w;
  if(y>VH+60||y+180<0)return;
  ctx.fillStyle="#0a1210";ctx.fillRect(x,y,w,180);
  var wg=ctx.createLinearGradient(0,y-16,0,y+16);
  wg.addColorStop(0,"rgba(111,240,208,0.20)");wg.addColorStop(1,"rgba(111,240,208,0)");
  ctx.fillStyle=wg;ctx.fillRect(x,y-16,w,32);
  ctx.fillStyle="rgba(111,240,208,0.10)";
  var i;
  for(i=0;i<w/70;i++){
    var wx=x+i*70+Math.sin(time*1.4+i)*12;
    ctx.fillRect(wx,y-6+Math.sin(time*2+i)*2,46,2);
  }
  ctx.fillStyle="#12241f";ctx.fillRect(x,y,w,8);
  ctx.fillStyle="rgba(143,224,204,0.25)";ctx.fillRect(x,y,w,1.5);
}
function drawRoof(s){
  var x=s.x-camx,y=s.y-camy,w=s.w;
  if(y>VH||y+30<0)return;
  /* il palazzo sotto il tetto: cosi' il tetto non vola */
  var wallH=GY-s.y-26;
  if(wallH>0){
    var wg=ctx.createLinearGradient(0,y+26,0,y+26+wallH);
    wg.addColorStop(0,"#122630");wg.addColorStop(1,"#0a171d");
    ctx.fillStyle=wg;
    ctx.fillRect(x,y+26,w,wallH);
    ctx.fillStyle="rgba(0,0,0,0.45)";
    var wx2,wy2;
    for(wy2=0;wy2<Math.floor(wallH/64);wy2++){
      for(wx2=0;wx2<Math.floor(w/54);wx2++){
        if(rnd(s.x*0.01+wy2*3.7+wx2*1.3)<0.55)continue;
        ctx.fillRect(x+16+wx2*54,y+44+wy2*64,16,22);
      }
    }
    ctx.fillStyle="rgba(0,0,0,0.35)";
    ctx.fillRect(x,y+26,w,wallH);
    ctx.fillStyle="rgba(232,180,74,0.05)";
    ctx.fillRect(x,y+26,w,wallH*0.4);
  }
  ctx.fillStyle="#16262e";ctx.fillRect(x,y,w,26);
  ctx.fillStyle="#263a44";ctx.fillRect(x,y,w,4);
  ctx.fillStyle="rgba(255,255,255,0.10)";ctx.fillRect(x,y,w,1.4);
  ctx.fillStyle="#0a1216";ctx.fillRect(x,y+24,w,3);
  /* ringhiera bassa */
  ctx.strokeStyle="rgba(140,176,190,0.35)";ctx.lineWidth=1.4;
  var i;
  for(i=0;i<w/46;i++){
    var px=x+14+i*46;
    ctx.beginPath();ctx.moveTo(px,y);ctx.lineTo(px,y-16);ctx.stroke();
  }
  ctx.beginPath();ctx.moveTo(x+14,y-16);ctx.lineTo(x+14+Math.floor(w/46)*46,y-16);ctx.stroke();
}
function drawCrate(s){
  var x=s.x-camx,y=s.y-camy,w=s.w,h=s.h;
  if(y>VH||y+h<0)return;
  ctx.fillStyle="#1b2b2a";ctx.fillRect(x,y,w,h);
  ctx.strokeStyle="rgba(232,180,74,0.35)";ctx.lineWidth=2;ctx.strokeRect(x+3,y+3,w-6,h-6);
  ctx.fillStyle="rgba(232,180,74,0.16)";ctx.fillRect(x+3,y+3,w-6,3);
}
function drawStructures(){
  var i,s;
  for(i=0;i<SOL.length;i++){
    s=SOL[i];
    if(s.k==="street")drawStreet(s);
    else if(s.k==="sewer")drawSewerFloor(s);
    else if(s.k==="roof")drawRoof(s);
    else drawCrate(s);
  }
}
function drawLadders(){
  var i,l,x,y0,y1;
  for(i=0;i<LAD.length;i++){
    l=LAD[i];
    x=l.x-camx;
    if(x<-40||x>VW+40)continue;
    y0=l.y0-camy;y1=l.y1-camy;
    if(Math.min(y0,y1)>VH||Math.max(y0,y1)<0)continue;
    ctx.strokeStyle="rgba(196,214,222,0.55)";ctx.lineWidth=2.6;
    ctx.beginPath();ctx.moveTo(x-9,y0);ctx.lineTo(x-9,y1);ctx.moveTo(x+9,y0);ctx.lineTo(x+9,y1);ctx.stroke();
    ctx.lineWidth=1.8;
    for(var k=0;k<=Math.abs(y0-y1)/26;k++){
      var ry=y0+(y1-y0)*(k/Math.max(1,Math.abs(y0-y1)/26));
      ctx.beginPath();ctx.moveTo(x-9,ry);ctx.lineTo(x+9,ry);ctx.stroke();
    }
    ctx.fillStyle="rgba(232,180,74,0.22)";ctx.fillRect(x-11,Math.min(y0,y1),22,3);
  }
}
/* ---- le cose da prendere ----------------------------------- */
function drawNotes(){
  var i,n,x,y,k;
  for(i=0;i<notes.length;i++){
    n=notes[i];
    if(n.got)continue;
    x=n.x-camx;y=n.y-camy;
    if(x<-80||x>VW+80||y<-80||y>VH+80)continue;
    var fl=Math.sin(time*2+i)*5;
    ctx.save();
    ctx.translate(x,y-34+fl);
    var gl=ctx.createRadialGradient(0,0,2,0,0,54);
    gl.addColorStop(0,"rgba(232,220,192,0.35)");gl.addColorStop(1,"rgba(232,220,192,0)");
    ctx.fillStyle=gl;ctx.beginPath();ctx.arc(0,0,54,0,6.3);ctx.fill();
    ctx.rotate(Math.sin(time*1.3+i)*0.08);
    ctx.fillStyle="#e8dcc0";ctx.fillRect(-11,-15,22,30);
    ctx.fillStyle="rgba(60,52,40,0.55)";
    for(k=0;k<5;k++)ctx.fillRect(-7,-9+k*5.4,14,1.2);
    ctx.fillStyle="rgba(197,142,142,0.8)";ctx.fillRect(-7,16,14,4);
    ctx.restore();
    ctx.globalAlpha=0.55+0.35*Math.sin(time*3+i);
    txt("NOTA",x,y-58,9,"#e8dcc0","center");
    ctx.globalAlpha=1;
  }
}
function drawCassette(){
  if(CASS.taken)return;
  var x=CASS.x-camx,y=CASS.y-camy;
  if(x<-140||x>VW+140||y<-160||y>VH+160)return;
  var fl=Math.sin(time*1.7)*4;
  ctx.save();
  ctx.translate(x,y-30+fl);
  var gl=ctx.createRadialGradient(0,0,4,0,0,110);
  gl.addColorStop(0,"rgba(232,180,74,0.35)");gl.addColorStop(1,"rgba(232,180,74,0)");
  ctx.fillStyle=gl;ctx.beginPath();ctx.arc(0,0,110,0,6.3);ctx.fill();
  ctx.rotate(-0.08);
  ctx.fillStyle="#12191d";ctx.fillRect(-42,-26,84,52);
  ctx.strokeStyle="rgba(232,180,74,0.75)";ctx.lineWidth=2;ctx.strokeRect(-40,-24,80,48);
  ctx.fillStyle="#0a1013";ctx.fillRect(-30,-12,60,30);
  ctx.fillStyle="rgba(232,220,192,0.9)";
  ctx.beginPath();ctx.arc(-13,3,7,0,6.3);ctx.fill();
  ctx.beginPath();ctx.arc(13,3,7,0,6.3);ctx.fill();
  ctx.fillStyle="#0a1013";
  ctx.beginPath();ctx.arc(-13,3,3,0,6.3);ctx.fill();
  ctx.beginPath();ctx.arc(13,3,3,0,6.3);ctx.fill();
  ctx.fillStyle="#e8dcc0";ctx.fillRect(-38,-22,76,9);
  txt("MEMORIE DEL COSMO",0,-15,6.4,"#12191d","center");
  ctx.restore();
  ctx.globalAlpha=0.6+0.3*Math.sin(time*3);
  txt("LA CASSETTA",x,y-78,10,"#e8b44a","center");
  ctx.globalAlpha=1;
}
function drawExit(){
  var x=EXIT.x-camx,y=EXIT.y-camy,on=G.cass;
  if(x<-360||x>VW+360)return;
  /* l'ombra sotto il furgone */
  ctx.fillStyle="rgba(0,0,0,0.5)";
  ctx.beginPath();ctx.ellipse(x,y,124,12,0,0,6.3);ctx.fill();
  /* il corpo */
  var bg=ctx.createLinearGradient(0,y-116,0,y);
  bg.addColorStop(0,"#22343d");bg.addColorStop(.55,"#16262e");bg.addColorStop(1,"#0c1519");
  ctx.fillStyle=bg;
  ctx.fillRect(x-116,y-116,232,116);
  ctx.fillStyle="#0d181d";ctx.fillRect(x-116,y-116,232,12);
  ctx.fillStyle="rgba(255,255,255,0.06)";ctx.fillRect(x-116,y-116,232,2);
  /* il finestrino e il portellone */
  ctx.fillStyle="#081115";ctx.fillRect(x-92,y-98,74,44);
  ctx.strokeStyle="rgba(140,176,190,0.35)";ctx.lineWidth=2;ctx.strokeRect(x-92,y-98,74,44);
  ctx.fillStyle="#081115";ctx.fillRect(x+6,y-98,86,74);
  ctx.fillStyle="rgba(232,180,74,0.10)";ctx.fillRect(x+6,y-98,86,74);
  /* la scritta sul fianco */
  ctx.save();
  ctx.fillStyle=on?"rgba(232,180,74,0.95)":"rgba(200,214,222,0.55)";
  txt("MEMORIE",x+49,y-58,13,on?"#e8b44a":"#a8b6be","center");
  txt("DEL COSMO",x+49,y-42,9,on?"#e8dcc0":"#7d8b93","center");
  ctx.restore();
  /* ruote */
  ctx.fillStyle="#050a0c";
  ctx.beginPath();ctx.arc(x-72,y-2,19,0,6.3);ctx.fill();
  ctx.beginPath();ctx.arc(x+70,y-2,19,0,6.3);ctx.fill();
  ctx.fillStyle="#1b2a31";
  ctx.beginPath();ctx.arc(x-72,y-2,8,0,6.3);ctx.fill();
  ctx.beginPath();ctx.arc(x+70,y-2,8,0,6.3);ctx.fill();
  /* i fari: due coni di luce */
  var i;
  for(i=0;i<2;i++){
    var hx=x-104+i*208;
    var lg=ctx.createRadialGradient(hx,y-86,3,hx,y-86,110);
    lg.addColorStop(0,on?"rgba(255,232,170,0.85)":"rgba(214,232,240,0.45)");
    lg.addColorStop(1,"rgba(255,232,170,0)");
    ctx.fillStyle=lg;ctx.beginPath();ctx.arc(hx,y-86,110,0,6.3);ctx.fill();
    ctx.fillStyle=on?"#fff0c0":"#cfe0e8";
    ctx.fillRect(hx-11,y-92,22,12);
  }
  /* il lampeggiante sul tetto */
  var bl=0.5+0.5*Math.sin(time*(on?7:2.2));
  ctx.fillStyle="rgba(232,180,74,"+(0.35+0.55*bl)+")";
  ctx.fillRect(x-18,y-126,36,10);
  var bg2=ctx.createRadialGradient(x,y-122,2,x,y-122,74);
  bg2.addColorStop(0,"rgba(232,180,74,"+(0.28+0.35*bl)+")");
  bg2.addColorStop(1,"rgba(232,180,74,0)");
  ctx.fillStyle=bg2;ctx.beginPath();ctx.arc(x,y-122,74,0,6.3);ctx.fill();
  ctx.globalAlpha=0.85+0.15*Math.sin(time*2.4);
  txt(on?"CONSEGNA QUI":"IL FURGONE",x,y-140,11,on?"#e8b44a":"#9aa8b0","center");
  ctx.globalAlpha=1;
  if(on){
    ctx.strokeStyle="rgba(232,180,74,"+(0.25+0.25*Math.sin(time*4))+")";
    ctx.lineWidth=2;
    ctx.beginPath();ctx.arc(x,y-40,118+Math.sin(time*3)*7,0,6.3);ctx.stroke();
  }
}
/* ---- le voragini: dove la strada si apre ------------------- */
var PITS=[[1500,1700],[3300,3520]];
function drawPits(){
  var i,k;
  for(i=0;i<PITS.length;i++){
    var x0=PITS[i][0]-camx,x1=PITS[i][1]-camx,w=x1-x0;
    if(x1<-40||x0>VW+40)continue;
    var yTop=GY-camy,yBot=SY-camy;
    if(yTop>VH||yBot<0)continue;
    var g=ctx.createLinearGradient(0,yTop,0,yBot);
    g.addColorStop(0,"#04090b");g.addColorStop(.75,"#061210");g.addColorStop(1,"#0b241f");
    ctx.fillStyle=g;ctx.fillRect(x0,yTop,w,yBot-yTop);
    /* i mattoni del pozzo */
    ctx.strokeStyle="rgba(90,140,126,0.14)";ctx.lineWidth=1;
    for(k=yTop+18;k<yBot;k+=22){
      ctx.beginPath();ctx.moveTo(x0,k);ctx.lineTo(x1,k);ctx.stroke();
    }
    /* il bordo: la strada che si spezza */
    ctx.fillStyle="#22343d";ctx.fillRect(x0-10,yTop-4,10,7);ctx.fillRect(x1,yTop-4,10,7);
    ctx.fillStyle="rgba(232,180,74,0.35)";
    ctx.fillRect(x0-10,yTop-4,10,2);ctx.fillRect(x1,yTop-4,10,2);
    /* il chiarore che sale dalle fogne */
    var gg=ctx.createLinearGradient(0,yBot-150,0,yBot);
    gg.addColorStop(0,"rgba(111,240,208,0)");
    gg.addColorStop(1,"rgba(111,240,208,0.18)");
    ctx.fillStyle=gg;ctx.fillRect(x0,yBot-150,w,150);
  }
}
/* ============================================================
   IL CONIGLIO — lo stesso disegno del museo (museo/player.js)
   ============================================================ */
function legDraw(hx,hy,fx,fy,knee,thick,color){
  var mx=(hx+fx)/2,my=(hy+fy)/2;
  var dx=fx-hx,dy=fy-hy,len=Math.sqrt(dx*dx+dy*dy)||1;
  var kx=mx+(-dy/len)*knee,ky=my+(dx/len)*knee;
  ctx.strokeStyle=color;ctx.lineWidth=thick;ctx.lineCap="round";
  ctx.beginPath();ctx.moveTo(hx,hy);ctx.quadraticCurveTo(kx,ky,fx,fy);ctx.stroke();
}
function drawRabbit(){
  var s=P.build||1;
  var run=P.state==="run",walk=P.state==="walk";
  var stride=(run?42:walk?26:0)*Math.min(1,P.speed/240);
  var bob=Math.sin(P.phase*2)*(walk?2.4:run?5:0)*s;
  var breathe=Math.sin(time*1.6)*1.2;
  var sit=P.bodyY;
  ctx.save();
  ctx.translate(P.x-camx,P.y-camy);
  if(P.invuln>0&&Math.floor(time*22)%2===0)ctx.globalAlpha=0.5;
  var sw=P.w*(1.05-(P.ground?0:0.3));
  var sh=ctx.createRadialGradient(0,0,1,0,0,sw);
  sh.addColorStop(0,"rgba(0,0,0,0.55)");sh.addColorStop(.6,"rgba(0,0,0,0.22)");sh.addColorStop(1,"rgba(0,0,0,0)");
  ctx.fillStyle=sh;ctx.beginPath();ctx.ellipse(0,0,sw,9*s,0,0,6.3);ctx.fill();
  ctx.scale(P.dir,1);
  ctx.translate(0,-sit+bob);
  var fur="#dcd5c6",furDark="#a89f8e",furDeep="#6d6557";
  var bodyH=56*s,bodyW=40*s;
  var hipY=-bodyH*0.42;
  var headX=20*s,headY=-bodyH-16*s;
  var g=P.phase*2,farOff=Math.PI;
  var f1x=-18*s+Math.cos(g+farOff)*stride*0.55;
  var f1y=-Math.max(0,Math.sin(g+farOff))*(walk?10:16)*s;
  var f2x=headX-4*s+Math.cos(g+farOff+Math.PI)*stride*0.45;
  var f2y=-Math.max(0,Math.sin(g+farOff+Math.PI))*(walk?8:12)*s;
  if(!P.ground){f1x=-16*s;f1y=-20*s;f2x=headX-8*s;f2y=-14*s;}
  legDraw(-10*s,hipY,f1x,f1y,8*s,9*s*P.line/3,furDeep);
  legDraw(headX-6*s,hipY+6*s,f2x,f2y,5*s,6*s*P.line/3,furDeep);
  ctx.save();
  ctx.translate(-bodyW*0.92,hipY-6*s);
  ctx.rotate(P.tailA);
  ctx.fillStyle="#f0ebdd";ctx.beginPath();ctx.arc(-3*s,0,7.5*s,0,6.3);ctx.fill();
  ctx.fillStyle="rgba(255,255,255,0.35)";ctx.beginPath();ctx.arc(-5*s,-2*s,3.4*s,0,6.3);ctx.fill();
  ctx.restore();
  ctx.beginPath();
  ctx.moveTo(-bodyW*0.78,hipY+10*s);
  ctx.bezierCurveTo(-bodyW*1.05,hipY-bodyH*0.5,-bodyW*0.35,-bodyH-4*s,headX*0.35,-bodyH-2*s);
  ctx.bezierCurveTo(headX*0.95,-bodyH+2*s,headX*0.92,hipY-2*s,bodyW*0.55,hipY+12*s);
  ctx.bezierCurveTo(bodyW*0.3,-2*s+breathe,-bodyW*0.3,2*s+breathe,-bodyW*0.78,hipY+10*s);
  ctx.closePath();
  var bg=ctx.createLinearGradient(-bodyW,-bodyH,bodyW,0);
  bg.addColorStop(0,"#f2ede0");bg.addColorStop(.45,fur);bg.addColorStop(1,furDark);
  ctx.fillStyle=bg;ctx.fill();
  ctx.strokeStyle="rgba(255,255,255,0.26)";ctx.lineWidth=1.1;
  var i;
  for(i=0;i<4;i++){
    ctx.beginPath();
    ctx.moveTo(-bodyW*0.5+i*8*s,-bodyH*0.75+i*4);
    ctx.quadraticCurveTo(-bodyW*0.3+i*8*s,-bodyH*0.92,-bodyW*0.1+i*8*s,-bodyH*0.72);
    ctx.stroke();
  }
  ctx.strokeStyle="rgba(255,255,255,0.20)";ctx.lineWidth=2;
  ctx.beginPath();
  ctx.moveTo(-bodyW*0.82,hipY+2*s);
  ctx.bezierCurveTo(-bodyW*0.98,hipY-bodyH*0.4,-bodyW*0.4,-bodyH,-headX*0.2,-bodyH-2*s);
  ctx.stroke();
  /* ---- zampe vicine ---- */
  var n1x=headX-8*s+Math.cos(g)*stride*0.5;
  var n1y=-Math.max(0,Math.sin(g))*(walk?12:18)*s;
  var n2x=headX-2*s+Math.cos(g+Math.PI)*stride*0.4;
  var n2y=-Math.max(0,Math.sin(g+Math.PI))*(walk?10:14)*s;
  if(!P.ground){n1x=headX-14*s;n1y=-16*s;n2x=headX-2*s;n2y=-10*s;}
  legDraw(-12*s,hipY+4*s,n1x,n1y,9*s,9*s*P.line/3,fur);
  legDraw(headX-6*s,hipY+10*s,n2x,n2y,5*s,7*s*P.line/3,fur);
  ctx.fillStyle=fur;
  ctx.beginPath();ctx.ellipse(n1x+3*s,n1y-2*s,11*s,4.4*s,0,0,6.3);ctx.fill();
  ctx.beginPath();ctx.ellipse(n2x+2*s,n2y-1.5*s,8*s,3.6*s,0,0,6.3);ctx.fill();
  /* ---- le orecchie: due molle ---- */
  function ear(angle,len,wdt,col,alpha){
    ctx.save();
    ctx.translate(headX-2*s,headY-8*s);
    ctx.rotate(angle);
    ctx.globalAlpha=alpha==null?1:alpha;
    ctx.beginPath();
    ctx.moveTo(-wdt*0.5,0);
    ctx.bezierCurveTo(-wdt*0.9,-len*0.55,-wdt*0.2,-len,wdt*0.1,-len);
    ctx.bezierCurveTo(wdt*0.7,-len*0.95,wdt*0.85,-len*0.45,wdt*0.5,0);
    ctx.closePath();
    var eg=ctx.createLinearGradient(0,0,0,-len);
    eg.addColorStop(0,col);eg.addColorStop(1,"#f6f2e6");
    ctx.fillStyle=eg;ctx.fill();
    ctx.fillStyle="rgba(214,150,150,0.42)";
    ctx.beginPath();ctx.ellipse(0,-len*0.52,wdt*0.22,len*0.4,0,0,6.3);ctx.fill();
    ctx.restore();
  }
  ear(P.ear2A-0.16,62*s,15*s,furDark,0.95);
  ear(P.earA+0.10,68*s,17*s,fur);
  /* ---- la testa ---- */
  ctx.save();
  ctx.translate(headX,headY);
  ctx.fillStyle=fur;
  ctx.beginPath();ctx.ellipse(0,0,20*s,18*s,-0.12,0,6.3);ctx.fill();
  ctx.beginPath();ctx.ellipse(13*s,6*s,11*s,8.4*s,0.16,0,6.3);
  ctx.fillStyle="#f4efe3";ctx.fill();
  ctx.fillStyle="#c58e8e";
  ctx.beginPath();ctx.ellipse(22*s,3.4*s,2.6*s,2*s,0.2,0,6.3);ctx.fill();
  var blink=P.blink>0?0.12:1;
  ctx.fillStyle="#0b0b0c";
  ctx.beginPath();ctx.ellipse(6.5*s,-3.5*s,3.4*s,4.2*s*blink,0,0,6.3);ctx.fill();
  if(blink>0.5){
    ctx.fillStyle="rgba(255,255,255,0.85)";
    ctx.beginPath();ctx.arc(7.6*s,-5.2*s,1.1*s,0,6.3);ctx.fill();
  }
  ctx.strokeStyle="rgba(255,255,255,0.28)";ctx.lineWidth=0.7;
  for(var w2=0;w2<3;w2++){
    ctx.beginPath();
    ctx.moveTo(21*s,4*s);
    ctx.quadraticCurveTo(33*s,(0+w2*5)*s,40*s,(-4+w2*6)*s);
    ctx.stroke();
  }
  ctx.restore();
  /* ---- l'arma in mano ---- */
  var aw=aimAngle();
  var la=Math.atan2(Math.sin(aw),Math.cos(aw)*(P.dir||1));
  ctx.save();
  ctx.translate(headX*0.55,-bodyH*0.62);
  ctx.rotate(la);
  drawWeapon(s);
  ctx.restore();
  /* ---- l'alone ---- */
  ctx.save();
  ctx.globalCompositeOperation="lighter";
  var rg2=ctx.createRadialGradient(headX,headY,2,headX,headY,42*s);
  rg2.addColorStop(0,"rgba(255,245,225,0.07)");rg2.addColorStop(1,"rgba(255,245,225,0)");
  ctx.fillStyle=rg2;ctx.beginPath();ctx.arc(headX,headY,42*s,0,6.3);ctx.fill();
  ctx.restore();
  ctx.restore();
}
/* le quattro armi, viste di lato, in mano al coniglio */
function drawWeapon(s){
  var w=curW(),rec=P.recoil*7*s;
  ctx.translate(-rec,0);
  if(w.id==="pistol"){
    ctx.fillStyle="#1b2226";ctx.fillRect(4*s,-4*s,26*s,9*s);
    ctx.fillStyle="#2b363c";ctx.fillRect(28*s,-2.6*s,9*s,5*s);
    ctx.fillStyle="#151b1f";ctx.fillRect(8*s,4*s,8*s,12*s);
    ctx.fillStyle="rgba(232,180,74,0.75)";ctx.fillRect(14*s,-3.4*s,6*s,2*s);
  }else if(w.id==="smg"){
    ctx.fillStyle="#1b2226";ctx.fillRect(0,-5*s,42*s,11*s);
    ctx.fillStyle="#2b363c";ctx.fillRect(42*s,-3*s,12*s,6*s);
    ctx.fillStyle="#151b1f";
    ctx.save();ctx.translate(16*s,6*s);ctx.rotate(0.22);ctx.fillRect(0,0,9*s,18*s);ctx.restore();
    ctx.fillStyle="#151b1f";ctx.fillRect(-12*s,-3*s,14*s,6*s);
    ctx.fillStyle="rgba(232,180,74,0.7)";ctx.fillRect(24*s,-4.4*s,10*s,2*s);
  }else if(w.id==="flame"){
    ctx.fillStyle="#2a1c14";ctx.beginPath();ctx.arc(-6*s,2*s,9*s,0,6.3);ctx.fill();
    ctx.fillStyle="#1b2226";ctx.fillRect(0,-4.5*s,34*s,9*s);
    ctx.fillStyle="#2b363c";ctx.fillRect(34*s,-2.5*s,11*s,5*s);
    ctx.fillStyle="rgba(255,154,60,0.9)";
    ctx.beginPath();ctx.arc(46*s,0,2.4*s+Math.sin(time*22)*1.4*s,0,6.3);ctx.fill();
  }else{
    ctx.fillStyle="#20272b";ctx.fillRect(-2*s,-2.6*s,22*s,5.2*s);
    ctx.fillStyle="#333d43";ctx.fillRect(18*s,-10*s,5*s,20*s);
    var bgr=ctx.createLinearGradient(22*s,0,110*s,0);
    bgr.addColorStop(0,"#cfd8dd");bgr.addColorStop(.5,"#eef4f7");bgr.addColorStop(1,"#9fb0b8");
    ctx.fillStyle=bgr;
    ctx.beginPath();
    ctx.moveTo(22*s,-2.4*s);ctx.lineTo(104*s,-1.2*s);ctx.lineTo(112*s,0);
    ctx.lineTo(104*s,1.2*s);ctx.lineTo(22*s,2.4*s);ctx.closePath();ctx.fill();
  }
  if(P.muzzle>0){
    var w2=curW(),tip=w2.id==="sword"?112*s:w2.id==="flame"?50*s:52*s;
    var mg=ctx.createRadialGradient(tip,0,1,tip,0,26*s);
    mg.addColorStop(0,"rgba(255,244,214,0.95)");
    mg.addColorStop(.4,"rgba(255,190,90,0.55)");
    mg.addColorStop(1,"rgba(255,160,60,0)");
    ctx.fillStyle=mg;ctx.beginPath();ctx.arc(tip,0,26*s,0,6.3);ctx.fill();
  }
  if(P.swing>0&&w.id==="sword"){
    var k=1-P.swing/0.26;
    ctx.strokeStyle="rgba(240,248,252,"+(0.75*(1-k))+")";
    ctx.lineWidth=7*s;
    ctx.beginPath();ctx.arc(10*s,0,96*s,-1.1+k*1.6,0.35+k*1.6);ctx.stroke();
  }
}
/* ============================================================
   LORO, DISEGNATI — margherite, soldati, droni-occhio
   ============================================================ */
function drawDaisy(e){
  var x=e.x-camx,y=e.y-camy;
  if(x<-90||x>VW+90||y<-140||y>VH+140)return;
  var sway=Math.sin(e.ph*2.4)*0.13,i;
  ctx.save();
  ctx.translate(x,y);
  ctx.strokeStyle=e.hit>0?"#ffc0c0":"#3f6b52";ctx.lineWidth=4;ctx.lineCap="round";
  ctx.beginPath();ctx.moveTo(0,0);ctx.quadraticCurveTo(sway*40,-30,sway*18,-60);ctx.stroke();
  ctx.fillStyle=e.hit>0?"#ffb3b3":"#2f5540";
  ctx.save();ctx.translate(sway*24,-34);ctx.rotate(0.5);ctx.beginPath();ctx.ellipse(0,0,13,5,0,0,6.3);ctx.fill();ctx.restore();
  ctx.save();ctx.translate(sway*20,-22);ctx.rotate(-2.4);ctx.beginPath();ctx.ellipse(0,0,11,4.4,0,0,6.3);ctx.fill();ctx.restore();
  ctx.save();
  ctx.translate(sway*14,-66);
  ctx.rotate(sway*0.6);
  for(i=0;i<12;i++){
    ctx.save();ctx.rotate(i/12*6.283);
    var pg=ctx.createLinearGradient(0,0,0,-26);
    pg.addColorStop(0,"rgba(255,255,252,0.95)");
    pg.addColorStop(1,"rgba(226,224,208,0.55)");
    ctx.fillStyle=e.hit>0?"#ffe0e0":pg;
    ctx.beginPath();ctx.ellipse(0,-19,6.5,14,0,0,6.3);ctx.fill();
    ctx.restore();
  }
  ctx.fillStyle=e.hit>0?"#ffd0d0":"#e8b44a";
  ctx.beginPath();ctx.arc(0,0,13,0,6.3);ctx.fill();
  ctx.fillStyle="rgba(0,0,0,0.35)";ctx.beginPath();ctx.arc(0,0,9,0,6.3);ctx.fill();
  var dx=P.x-e.x,dy=(P.y-52)-e.y;
  var dl=Math.sqrt(dx*dx+dy*dy)||1;
  ctx.fillStyle="#0a0a0a";
  ctx.beginPath();ctx.arc(dx/dl*4.4,dy/dl*4.4,5.2,0,6.3);ctx.fill();
  ctx.fillStyle="rgba(255,255,255,0.8)";
  ctx.beginPath();ctx.arc(dx/dl*4.4-1.6,dy/dl*4.4-1.8,1.4,0,6.3);ctx.fill();
  ctx.restore();
  ctx.restore();
}
function drawSoldier(e){
  var x=e.x-camx,y=e.y-camy;
  if(x<-90||x>VW+90||y<-160||y>VH+160)return;
  var fl=e.hit>0;
  var body=fl?"#5a2a2a":"#16232b",rim=fl?"#ffd0d0":"#2f4a58";
  ctx.save();
  ctx.translate(x,y);
  ctx.scale(e.dir,1);
  ctx.fillStyle="rgba(0,0,0,0.35)";
  ctx.beginPath();ctx.ellipse(0,0,26,7,0,0,6.3);ctx.fill();
  ctx.fillStyle=body;
  ctx.fillRect(-16,-34,10,34);
  ctx.fillRect(4,-34,10,34);
  ctx.beginPath();
  ctx.moveTo(-22,-34);ctx.lineTo(-16,-86);ctx.lineTo(14,-86);ctx.lineTo(22,-34);
  ctx.lineTo(8,-30);ctx.lineTo(-8,-30);ctx.closePath();
  ctx.fillStyle=body;ctx.fill();
  ctx.strokeStyle=rim;ctx.lineWidth=1.4;ctx.stroke();
  ctx.fillStyle="#0e181d";
  ctx.beginPath();ctx.arc(2,-98,16,Math.PI,0);ctx.fill();
  ctx.fillRect(-14,-99,32,5);
  ctx.beginPath();ctx.ellipse(2,-88,13,13,0,0,6.3);ctx.fill();
  ctx.fillStyle="rgba(255,90,90,0.95)";
  ctx.fillRect(2,-90,7,2.6);
  ctx.fillRect(-7,-90,7,2.6);
  ctx.fillStyle="#0b1216";
  ctx.fillRect(-6,-74,60,5);
  ctx.fillRect(44,-76,16,3);
  ctx.fillRect(-2,-70,8,12);
  ctx.fillStyle="rgba(232,180,74,0.5)";ctx.fillRect(24,-75,10,1.6);
  ctx.restore();
}
function drawDrone(e){
  var x=e.x-camx,y=e.y-camy;
  if(x<-90||x>VW+90||y<-140||y>VH+140)return;
  var fl=e.hit>0,i,a,px,py;
  ctx.save();
  ctx.translate(x,y-34);
  var gl=ctx.createRadialGradient(0,0,2,0,0,52);
  gl.addColorStop(0,"rgba(255,110,90,0.28)");gl.addColorStop(1,"rgba(255,110,90,0)");
  ctx.fillStyle=gl;ctx.beginPath();ctx.arc(0,0,52,0,6.3);ctx.fill();
  ctx.strokeStyle="rgba(190,214,224,0.5)";ctx.lineWidth=2;
  for(i=0;i<4;i++){
    a=i/4*6.283+Math.PI/4;
    px=Math.cos(a)*26;py=Math.sin(a)*13;
    ctx.beginPath();ctx.moveTo(0,0);ctx.lineTo(px,py);ctx.stroke();
    ctx.beginPath();ctx.ellipse(px,py,10,3,0,0,6.3);ctx.stroke();
  }
  var bg=ctx.createLinearGradient(0,-18,0,18);
  bg.addColorStop(0,fl?"#7a3030":"#22343d");
  bg.addColorStop(1,"#0c1519");
  ctx.fillStyle=bg;
  ctx.beginPath();ctx.arc(0,0,18,0,6.3);ctx.fill();
  ctx.strokeStyle="rgba(200,224,232,0.35)";ctx.lineWidth=1.4;
  ctx.beginPath();ctx.arc(0,0,18,0,6.3);ctx.stroke();
  var dx=P.x-e.x,dy=(P.y-52)-(e.y-34);
  var dl=Math.sqrt(dx*dx+dy*dy)||1;
  ctx.fillStyle="#0a0e10";ctx.beginPath();ctx.arc(0,0,11,0,6.3);ctx.fill();
  var eg=ctx.createRadialGradient(dx/dl*3,dy/dl*3,1,dx/dl*3,dy/dl*3,9);
  eg.addColorStop(0,"#ffd8b0");eg.addColorStop(.5,"#ff6a4a");eg.addColorStop(1,"#601008");
  ctx.fillStyle=eg;
  ctx.beginPath();ctx.arc(dx/dl*3,dy/dl*3,8,0,6.3);ctx.fill();
  ctx.fillStyle="#08080a";
  ctx.beginPath();ctx.arc(dx/dl*4,dy/dl*4,3.4,0,6.3);ctx.fill();
  ctx.restore();
}
function drawEnemies(){
  var i,e,x,y;
  for(i=0;i<ents.length;i++){
    e=ents[i];
    if(e.dead)continue;
    if(e.t==="daisy")drawDaisy(e);
    else if(e.t==="soldier")drawSoldier(e);
    else drawDrone(e);
    if(e.hp<e.max){
      x=e.x-camx;y=e.y-camy-(e.t==="drone"?62:e.t==="daisy"?96:126);
      ctx.fillStyle="rgba(0,0,0,0.6)";ctx.fillRect(x-22,y,44,4);
      ctx.fillStyle=e.t==="daisy"?"#f2efd8":"#ff7a4a";
      ctx.fillRect(x-22,y,44*(e.hp/e.max),4);
    }
  }
}
function drawBullets(){
  var i,b,x,y,fg,rg;
  for(i=0;i<bul.length;i++){
    b=bul[i];x=b.x-camx;y=b.y-camy;
    if(x<-40||x>VW+40||y<-40||y>VH+40)continue;
    if(b.flame){
      fg=ctx.createRadialGradient(x,y,1,x,y,b.r*2.2);
      fg.addColorStop(0,"rgba(255,240,190,0.9)");
      fg.addColorStop(.4,"rgba(255,150,60,0.55)");
      fg.addColorStop(1,"rgba(255,80,20,0)");
      ctx.fillStyle=fg;ctx.beginPath();ctx.arc(x,y,b.r*2.2,0,6.3);ctx.fill();
    }else{
      ctx.strokeStyle=rgba(b.col,0.7);ctx.lineWidth=2.4;
      ctx.beginPath();ctx.moveTo(x-b.vx*0.016,y-b.vy*0.016);ctx.lineTo(x,y);ctx.stroke();
      ctx.fillStyle="#fff6dd";ctx.beginPath();ctx.arc(x,y,b.r,0,6.3);ctx.fill();
    }
  }
  for(i=0;i<eb.length;i++){
    b=eb[i];x=b.x-camx;y=b.y-camy;
    if(x<-40||x>VW+40||y<-40||y>VH+40)continue;
    rg=ctx.createRadialGradient(x,y,1,x,y,14);
    rg.addColorStop(0,"rgba(255,220,200,0.95)");
    rg.addColorStop(.45,"rgba(255,90,90,0.7)");
    rg.addColorStop(1,"rgba(255,60,60,0)");
    ctx.fillStyle=rg;ctx.beginPath();ctx.arc(x,y,14,0,6.3);ctx.fill();
    ctx.fillStyle="#ffe6e0";ctx.beginPath();ctx.arc(x,y,2.6,0,6.3);ctx.fill();
  }
}
function drawParts(){
  var i,p,x,y;
  for(i=0;i<parts.length;i++){
    p=parts[i];x=p.x-camx;y=p.y-camy;
    if(x<-40||x>VW+40||y<-40||y>VH+40)continue;
    ctx.globalAlpha=Math.max(0,Math.min(1,p.life/p.max));
    ctx.fillStyle=p.col;
    ctx.beginPath();ctx.arc(x,y,p.r,0,6.3);ctx.fill();
  }
  ctx.globalAlpha=1;
}
/* ---- la parete delle fogne, quando si e' sotto --------------- */
function drawSewerBack(){
  var depth=Math.min(1,Math.max(0,(camy-(GY-VH*0.55))/380));
  if(depth<=0.02)return;
  ctx.save();
  ctx.globalAlpha=depth;
  var g=ctx.createLinearGradient(0,0,0,VH);
  g.addColorStop(0,"#07100e");g.addColorStop(.6,"#0a1512");g.addColorStop(1,"#050c0a");
  ctx.fillStyle=g;ctx.fillRect(0,0,VW,VH);
  var i,off=(camx*0.62)%320,ax,ay;
  /* gli archi: la fogna e' un tubo di mattoni */
  for(i=-1;i<5;i++){
    ax=i*320-off+120;
    ay=VH*0.92;
    ctx.strokeStyle="rgba(84,150,128,0.13)";ctx.lineWidth=30;
    ctx.beginPath();ctx.arc(ax,ay,128,Math.PI,0);ctx.stroke();
    ctx.strokeStyle="rgba(150,232,204,0.10)";ctx.lineWidth=2;
    ctx.beginPath();ctx.arc(ax,ay,146,Math.PI,0);ctx.stroke();
    ctx.fillStyle="rgba(4,10,8,0.85)";
    ctx.beginPath();ctx.arc(ax,ay,110,Math.PI,0);ctx.fill();
    ctx.fillRect(ax-110,ay-6,220,20);
    /* la luce che filtra dal tombino */
    var lg=ctx.createLinearGradient(0,120,0,VH*0.9);
    lg.addColorStop(0,"rgba(111,240,208,0.06)");
    lg.addColorStop(1,"rgba(111,240,208,0)");
    ctx.fillStyle=lg;
    ctx.beginPath();ctx.moveTo(ax-26,120);ctx.lineTo(ax+26,120);
    ctx.lineTo(ax+130,VH*0.92);ctx.lineTo(ax-130,VH*0.92);ctx.closePath();ctx.fill();
  }
  /* i tubi che corrono sopra la testa */
  ctx.strokeStyle="rgba(120,170,160,0.16)";ctx.lineWidth=9;
  ctx.beginPath();ctx.moveTo(-20,108);ctx.lineTo(VW+20,108);ctx.stroke();
  ctx.strokeStyle="rgba(90,140,130,0.12)";ctx.lineWidth=5;
  ctx.beginPath();ctx.moveTo(-20,132);ctx.lineTo(VW+20,132);ctx.stroke();
  for(i=0;i<6;i++){
    var px=((i*220-camx*0.62)%(VW+220)+(VW+220))%(VW+220)-110;
    ctx.fillStyle="rgba(70,110,102,0.35)";
    ctx.fillRect(px,104,12,9);
  }
  /* vapore basso */
  ctx.globalAlpha=depth*0.10;ctx.fillStyle="#8fe0cc";
  for(i=0;i<3;i++)ctx.fillRect(0,VH*0.62+i*60+Math.sin(time*.5+i)*12,VW,30);
  ctx.restore();
}
/* ============================================================
   L'OCCHIO NEL CIELO
   ============================================================ */
function drawEye(){
  /* L'occhio nel cielo: è sempre presente in alto nel cielo a osservare il coniglio.
     Segue il movimento del giocatore e la sua pupilla lo fissa continuamente.
     Quando si prende la cassetta (G.eyeOn) l'occhio diventa vigile, pulsa e scende il conto alla rovescia. */
  var on=G.eyeOn;
  var t=on?G.eyeT:999;
  var urgent=on&&(t<15);
  var pulse=urgent?0.5+0.5*Math.sin(time*8):0.5+0.5*Math.sin(time*1.4);

  /* Posizione dell'occhio a schermo: l'occhio in cielo insegue il giocatore con morbida inerzia */
  var ex=clamp(G.eyeX-camx,150,VW-150);
  var ey=G.eyeY;
  if(on){
    var chase=Math.min(1,Math.max(0,1-G.eyeT/(G.eyeMax||40)));
    ey+=chase*38;
  }

  var EK=on?(urgent?0.74:0.68):0.62;

  ctx.save();

  /* L'alone di luce nel cielo */
  var halo=ctx.createRadialGradient(ex,ey,20,ex,ey,340*EK);
  if(urgent){
    halo.addColorStop(0,"rgba(255,80,60,"+(0.35+0.25*pulse)+")");
    halo.addColorStop(0.5,"rgba(220,90,60,0.14)");
  }else if(on){
    halo.addColorStop(0,"rgba(245,210,140,0.24)");
    halo.addColorStop(0.5,"rgba(200,160,100,0.08)");
  }else{
    halo.addColorStop(0,"rgba(200,215,230,0.12)");
    halo.addColorStop(0.5,"rgba(160,180,200,0.04)");
  }
  halo.addColorStop(1,"rgba(0,0,0,0)");
  ctx.fillStyle=halo;ctx.beginPath();ctx.arc(ex,ey,340*EK,0,6.3);ctx.fill();

  /* Palpebre */
  var lid=on?(1-Math.abs(Math.sin(time*0.7))*0.05):(0.76-Math.abs(Math.sin(time*0.4))*0.06);
  if(G.eyeBlink>0)lid=0.28;

  ctx.save();
  ctx.translate(ex,ey);
  ctx.scale(EK,EK*lid);

  /* Bulbo oculare */
  var sc=ctx.createRadialGradient(-30,-24,10,0,0,180);
  if(urgent){
    sc.addColorStop(0,"#fff2e8");sc.addColorStop(0.65,"#edd1be");sc.addColorStop(1,"#b5877b");
  }else{
    sc.addColorStop(0,"#fbf6ea");sc.addColorStop(0.65,"#ded4c2");sc.addColorStop(1,"#a89b88");
  }
  ctx.fillStyle=sc;
  ctx.beginPath();ctx.ellipse(0,0,178,112,0,0,6.3);ctx.fill();

  /* Vene che pulsano quando il tempo stringe */
  if(urgent){
    ctx.strokeStyle="rgba(220,40,40,"+(0.35+0.35*pulse)+")";ctx.lineWidth=2.2;
    var v;
    for(v=0;v<7;v++){
      var va=v/7*6.283;
      ctx.beginPath();
      ctx.moveTo(Math.cos(va)*150,Math.sin(va)*92);
      ctx.quadraticCurveTo(Math.cos(va+0.3)*100,Math.sin(va+0.3)*70,Math.cos(va+0.18)*60,Math.sin(va+0.18)*44);
      ctx.stroke();
    }
  }

  /* L'IRIDE E LA PUPILLA: puntano esattamente verso la posizione a schermo del giocatore */
  var playerScreenX=P.x-camx;
  var playerScreenY=(P.y-48)-camy;
  var dx=playerScreenX-ex;
  var dy=playerScreenY-ey;
  var dl=Math.sqrt(dx*dx+dy*dy)||1;
  var maxLookX=64;
  var maxLookY=36;
  var ix=clamp((dx/dl)*68,-maxLookX,maxLookX);
  var iy=clamp((dy/dl)*44,-maxLookY,maxLookY);

  var ig=ctx.createRadialGradient(ix,iy,6,ix,iy,74);
  if(urgent){
    ig.addColorStop(0,"#ffb08a");
    ig.addColorStop(0.55,"#c23a2a");
    ig.addColorStop(1,"#20180e");
  }else if(on){
    ig.addColorStop(0,"#e8c98a");
    ig.addColorStop(0.55,"#8f7036");
    ig.addColorStop(1,"#20180e");
  }else{
    ig.addColorStop(0,"#cfd8dc");
    ig.addColorStop(0.55,"#546e7a");
    ig.addColorStop(1,"#121b20");
  }
  ctx.fillStyle=ig;
  ctx.beginPath();ctx.arc(ix,iy,74,0,6.3);ctx.fill();

  /* Pupilla */
  ctx.fillStyle="#08080a";
  ctx.beginPath();ctx.arc(ix,iy,on?36:28,0,6.3);ctx.fill();

  /* Riflesso luce */
  ctx.fillStyle="rgba(255,255,255,0.85)";
  ctx.beginPath();ctx.arc(ix-18,iy-20,9,0,6.3);ctx.fill();

  /* Contorno e ciglia */
  ctx.strokeStyle="rgba(20,14,10,0.55)";ctx.lineWidth=6;
  ctx.beginPath();ctx.ellipse(0,0,178,112,0,0,6.3);ctx.stroke();

  ctx.restore();

  /* Fascio di luce conico quando urgente */
  if(urgent){
    var ang=Math.atan2(dy,dx);
    ctx.save();
    ctx.translate(ex,ey);
    ctx.rotate(ang-Math.PI/2);
    var bg=ctx.createLinearGradient(0,0,0,VH);
    bg.addColorStop(0,"rgba(255,90,70,"+(0.16+0.18*pulse)+")");
    bg.addColorStop(1,"rgba(255,90,70,0)");
    ctx.fillStyle=bg;
    ctx.beginPath();
    ctx.moveTo(-50*EK,50*EK);
    ctx.lineTo(50*EK,50*EK);
    ctx.lineTo(260*EK,VH*1.2);
    ctx.lineTo(-260*EK,VH*1.2);
    ctx.closePath();
    ctx.fill();
    ctx.restore();
  }

  ctx.restore();
}
/* ============================================================
   LA TESTA DEL GIOCATORE — vita, armi, tempo, mappa
   ============================================================ */
function fmt(t){
  if(t<0)t=0;
  var m=Math.floor(t/60),s=Math.floor(t%60);
  return (m<10?"0":"")+m+":"+(s<10?"0":"")+s;
}
function drawHUD(){
  var i;
  /* vita */
  txt("VITA",24,26,9,"#5d676c");
  for(i=0;i<G.maxhp;i++){
    ctx.fillStyle=i<G.hp?"#e8b44a":"rgba(232,180,74,0.18)";
    ctx.fillRect(24+i*22,32,17,6);
  }
  /* la radio della cassetta: si accende con M */
  txt("RADIO "+(AUD_ON?"\u25cf":"\u25cb")+" tg"+MEM+".MP3",24,52,8,
    AUD_ERR?"#7a3a34":(AUD_ON?"#e8b44a":"#4a5257"));
  /* le due armi */
  for(i=0;i<SLOTS.length;i++){
    var y=VH-58-i*26,act=i===WI;
    ctx.fillStyle=act?"rgba(232,180,74,0.14)":"rgba(10,14,16,0.55)";
    ctx.fillRect(20,y,196,22);
    ctx.strokeStyle=act?"rgba(232,180,74,0.75)":"rgba(120,140,150,0.25)";
    ctx.lineWidth=1;ctx.strokeRect(20.5,y+0.5,195,21);
    txt((i+1)+" · "+WDEF[SLOTS[i]].name,30,y+15,10,act?"#e8b44a":"#78838a");
  }
  /* obiettivo */
  var obj=G.cass?"TORNA AL FURGONE · CONSEGNA LA CASSETTA":"TROVA LA CASSETTA · "+MZ.where.toUpperCase();
  var ow=obj.length*6.4+28;
  ctx.fillStyle="rgba(6,10,12,0.6)";
  ctx.fillRect(VW/2-ow/2,14,ow,18);
  txt(obj,VW/2,27,10,G.cass?"#e8b44a":"#a6b6bd","center");
  if(G.eyeOn){
    var t=G.eyeT,urgent=t<15;
    var col=urgent&&Math.floor(time*6)%2===0?"#ff6a5a":"#f0e2c4";
    ctx.fillStyle="rgba(6,10,12,0.78)";
    ctx.fillRect(VW/2-124,28,248,62);
    ctx.strokeStyle="rgba(232,180,74,0.45)";ctx.lineWidth=1;
    ctx.strokeRect(VW/2-123.5,28.5,247,61);
    txt(fmt(t),VW/2,72,34,col,"center",700);
    txt("PRIMA CHE L'OCCHIO TI VEDA",VW/2,85,8,"#8a9398","center");
  }
  /* mappa */
  var mw=196,mh=92,mx=VW-mw-22,my=VH-mh-22;
  ctx.fillStyle="rgba(6,10,12,0.72)";ctx.fillRect(mx,my,mw,mh);
  ctx.strokeStyle="rgba(140,170,182,0.35)";ctx.lineWidth=1;ctx.strokeRect(mx+.5,my+.5,mw-1,mh-1);
  var sx=mw/W,sy=mh/H;
  for(i=0;i<SOL.length;i++){
    var s=SOL[i];
    ctx.fillStyle=s.k==="street"?"rgba(120,160,176,0.30)":s.k==="sewer"?"rgba(111,240,208,0.20)":"rgba(160,190,200,0.45)";
    ctx.fillRect(mx+s.x*sx,my+s.y*sy,Math.max(1,s.w*sx),Math.max(1,s.h*sy));
  }
  /* il furgone e la cassetta */
  ctx.fillStyle="#e8b44a";ctx.fillRect(mx+EXIT.x*sx-2,my+EXIT.y*sy-2,4,4);
  if(!CASS.taken){ctx.fillStyle="#f2e6c8";ctx.fillRect(mx+CASS.x*sx-2,my+CASS.y*sy-2,4,4);}
    ctx.fillStyle="rgba(255,110,90,0.9)";
  for(i=0;i<ents.length;i++){
    if(ents[i].dead)continue;
    ctx.fillRect(mx+ents[i].x*sx-1.5,my+ents[i].y*sy-1.5,3,3);
  }
  ctx.fillStyle="#ffffff";
  ctx.fillRect(mx+P.x*sx-2,my+P.y*sy-2,4,4);
  /* riquadro della vista */
  ctx.strokeStyle="rgba(255,255,255,0.22)";
  ctx.strokeRect(mx+camx*sx,my+camy*sy,VW*sx,VH*sy);
  txt(MZ.nome,mx+8,my+13,9,"#5d676c");
  /* il messaggio */
  if(G.msgT>0){
    var a=Math.min(1,G.msgT/0.6);
    ctx.globalAlpha=a;
    var tw2=Math.min(VW-80,G.msg.length*7.4+40);
    ctx.fillStyle="rgba(6,10,12,0.86)";
    ctx.fillRect(VW/2-tw2/2,VH-104,tw2,30);
    ctx.strokeStyle="rgba(232,180,74,0.5)";ctx.lineWidth=1;
    ctx.strokeRect(VW/2-tw2/2+.5,VH-103.5,tw2-1,29);
    txt(G.msg,VW/2,VH-84,10,"#e8dcc0","center");
    ctx.globalAlpha=1;
  }
  /* vignetta */
  var v=ctx.createRadialGradient(VW/2,VH*.46,190,VW/2,VH/2,700);
  v.addColorStop(0,"rgba(0,0,0,0)");v.addColorStop(1,"rgba(0,0,0,0.46)");
  ctx.fillStyle=v;ctx.fillRect(0,0,VW,VH);
}
/* ============================================================
   LA MARGHERITA — la fine, quando l'occhio ti prende
   ============================================================ */
function drawDaisyAnim(){
  var k=Math.min(1,G.daisy/2.2);
  var x=P.x-camx,y=P.y-camy;
  var i,a,r,alpha;
  ctx.save();
  if(G.daisy<0.5){
    ctx.globalAlpha=1-G.daisy/0.5;
    ctx.fillStyle="rgba(255,250,235,0.8)";
    ctx.beginPath();ctx.arc(x,y-50,260*G.daisy/0.5+40,0,6.3);ctx.fill();
    ctx.globalAlpha=1;
  }
  ctx.translate(x,y-50);
  for(i=0;i<12;i++){
    a=i/12*6.283+(1-k)*0.6;
    r=lerp(6,80,k);
    alpha=Math.min(1,k*1.8);
    ctx.save();
    ctx.translate(Math.cos(a)*r*0.85,Math.sin(a)*r*0.6);
    ctx.rotate(a+1.57);
    ctx.globalAlpha=alpha;
    var pg=ctx.createLinearGradient(0,-16,0,16);
    pg.addColorStop(0,"rgba(255,255,252,0.98)");
    pg.addColorStop(1,"rgba(224,222,206,0.62)");
    ctx.fillStyle=pg;
    ctx.beginPath();ctx.ellipse(0,0,lerp(3,11,k),lerp(6,23,k),0,0,6.3);ctx.fill();
    ctx.restore();
  }
  ctx.globalAlpha=Math.min(1,k*1.5);
  var cg=ctx.createRadialGradient(0,0,2,0,0,26*k+8);
  cg.addColorStop(0,"#ffe9a8");cg.addColorStop(.6,"#e8b44a");cg.addColorStop(1,"#8a6420");
  ctx.fillStyle=cg;
  ctx.beginPath();ctx.arc(0,0,lerp(6,25,k),0,6.3);ctx.fill();
  ctx.fillStyle="#1a1208";
  ctx.beginPath();ctx.arc(0,0,lerp(3,10,k),0,6.3);ctx.fill();
  ctx.globalAlpha=1;
  ctx.strokeStyle="rgba(63,107,82,0.9)";ctx.lineWidth=5;
  ctx.beginPath();ctx.moveTo(0,10);ctx.quadraticCurveTo(6,60,0,112);ctx.stroke();
  ctx.restore();
}
/* ============================================================
   I CARTELLI — inizio, vittoria, fine
   ============================================================ */
function panelBox(x,y,w,h){
  ctx.fillStyle="rgba(4,7,8,0.94)";
  ctx.fillRect(x,y,w,h);
  ctx.strokeStyle="rgba(232,180,74,0.55)";ctx.lineWidth=1;
  ctx.strokeRect(x+.5,y+.5,w-1,h-1);
  ctx.fillStyle="rgba(232,180,74,0.10)";
  ctx.fillRect(x,y,w,3);
}
function drawOverlays(){
  var a,a2,a3;
  if(G.intro>0){
    a=Math.min(1,G.intro/1.0);
    ctx.fillStyle="rgba(3,5,6,"+a+")";ctx.fillRect(0,0,VW,VH);
    ctx.globalAlpha=a;
    txt("MEMORIE DEL COSMO",VW/2,VH/2-30,26,"#f0e2c4","center");
    txt("MISSIONE "+MEM+" · "+MZ.nome,VW/2,VH/2+2,12,"#e8b44a","center");
    txt(MZ.it,VW/2,VH/2-10,11,"#8fa0a8","center");
    txt("armi: "+WDEF[SLOTS[0]].name+(SLOTS[1]&&SLOTS[1]!==SLOTS[0]?" + "+WDEF[SLOTS[1]].name:""),
      VW/2,VH/2+24,10,"#8fa0a8","center");
    txt("radio: tg"+MEM+".MP3 · M accende / spegne",VW/2,VH/2+42,9,"#7f8f96","center");
    txt("A/D muovi · SPAZIO salta · W/S scale · click spara · 1/2 armi",VW/2,VH/2+62,9,"#5d676c","center");
    ctx.globalAlpha=1;
  }
  if(G.daisy>0){
    a2=Math.min(1,Math.max(0,(G.daisy-0.5)/1.4));
    ctx.fillStyle="rgba(3,5,6,"+(a2*0.5)+")";ctx.fillRect(0,0,VW,VH);
    if(a2>0.15){
      ctx.globalAlpha=a2;
      txt(G.reason||"",VW/2,VH-158,11,"#ff9a8a","center");
      txt("diventi una margherita",VW/2,VH-136,13,"#f2efd8","center");
      ctx.globalAlpha=1;
    }
    if(G.ended){
      panelBox(VW/2-250,VH/2-92,500,184);
      txt("SEI UNA MARGHERITA",VW/2,VH/2-42,22,"#f2efd8","center");
      txt("l'occhio ha visto. la strada si e' chiusa.",VW/2,VH/2-10,11,"#c9c2b0","center");
      txt("il coniglio non e' tornato al furgone.",VW/2,VH/2+12,11,"#8a9398","center");
      txt("R · RICOMINCIA        ESC · MEMORIE DEL COSMO",VW/2,VH/2+56,10,"#e8b44a","center");
    }
  }
  if(G.win>0){
    a3=Math.min(1,G.win/0.7);
    ctx.fillStyle="rgba(3,5,6,"+(a3*0.55)+")";ctx.fillRect(0,0,VW,VH);
    if(G.win>0.7){
      panelBox(VW/2-270,VH/2-104,540,208);
      txt("MEMORIA RECUPERATA",VW/2,VH/2-52,22,"#e8b44a","center");
      txt("la cassetta e' al sicuro nel furgone.",VW/2,VH/2-20,11,"#e8dcc0","center");
      txt("l'occhio e' rimasto in cielo, con un ricordo in meno.",VW/2,VH/2+2,11,"#8a9398","center");
      txt("MISSIONE "+MEM+" · "+MZ.it.toUpperCase()+" · COMPLETATA",VW/2,VH/2+34,10,"#8fa0a8","center");
      txt("Rientro a Memorie del Cosmo...",VW/2,VH/2+70,10,"#e8b44a","center");
    }
  }
}
/* ============================================================
   IL GIRO
   ============================================================ */
function update(){
  var i;
  G.msgT=Math.max(0,G.msgT-dt);
  G.shake*=Math.pow(0.02,dt);
  G.flash=Math.max(0,G.flash-dt*1.8);
  if(G.intro>0)G.intro-=dt;
  if(G.daisy>0){
    G.daisy+=dt;
    if(G.daisy>2.9&&!G.ended)G.ended=true;
  }else if(G.win>0){
    G.win+=dt;
    if(G.win>2.2&&!G.ended){
      G.ended=true;
      returnToCosmo();
    }
  }else{
    updatePlayer();
    if(!P.dead&&(mouse.down||keys["j"]))fire();
    updateBullets();
    updateEnemies();
    updatePickups();
    updateEye();
  }
  updateParts();
  for(i=ents.length-1;i>=0;i--){
    if(ents[i].dead&&Math.random()<dt*1.2)ents.splice(i,1);
  }
  updateCam();
}
function draw(){
  ctx.setTransform(scale,0,0,scale,offX,offY);
  ctx.clearRect(0,0,VW,VH);
  drawSky();
  drawSewerBack();
  ctx.save();
  if(G.shake>0.2)ctx.translate((Math.random()-0.5)*G.shake,(Math.random()-0.5)*G.shake);
  drawStructures();
  drawPits();
  drawLadders();
  drawExit();
  drawNotes();
  drawCassette();
  drawEnemies();
  drawBullets();
  drawParts();
  if(G.daisy>0)drawDaisyAnim();
  else drawRabbit();
  ctx.restore();
  drawEye();
  if(G.flash>0){
    ctx.fillStyle="rgba(255,200,140,"+(G.flash*0.45)+")";
    ctx.fillRect(0,0,VW,VH);
  }
  drawHUD();
  drawOverlays();
}
var last=0;
function frame(ts){
  var now=ts||0;
  dt=last?Math.min(0.034,(now-last)/1000):0.016;
  last=now;
  if(!(dt>0))dt=0.016;
  time+=dt;
  update();
  draw();
  requestAnimationFrame(frame);
}
reset();
draw();
requestAnimationFrame(frame);
/* una presa per gli strumenti di controllo (screenshot, prove) */
window.COSMO_DBG={
  P:P,G:G,mouse:mouse,
  mem:MEM,mission:MZ,
  audio:function(){return {on:AUD_ON,err:AUD_ERR,src:AUD?(AUD.src||""):"",vol:AUD?AUD.volume:0};},
  radio:function(){audioToggle();},
  returnToCosmo:function(){returnToCosmo();},
  warp:function(x,y){P.x=x;P.y=y;P.vx=0;P.vy=0;camx=clamp(x-VW/2,0,W-VW);camy=clamp(y-VH*0.6,0,H-VH);},
  eyeOn:function(t){G.eyeOn=true;G.eyeT=t||40;},
  daisy:function(r){startDaisy(r||"PROVA");},
  win:function(){winMission();},
  take:function(){updatePickups();},
  fire:function(){fire();},
  intro:function(){G.intro=0;},
  cam:function(){return {x:camx,y:camy};},
  keys:keys,
  info:function(){return {mem:MEM,px:Math.round(P.x),py:Math.round(P.y),cx:Math.round(camx),cy:Math.round(camy),eye:Math.round(G.eyeT*10)/10,on:G.eyeOn,cass:G.cass,hp:G.hp,win:Math.round(G.win*10)/10,daisy:Math.round(G.daisy*10)/10,ladder:P.onLadder,timer:MZ.timer,maxhp:MZ.hp,notes:notes.length,foes:ents.length,audio:AUD_ON};},
  step:function(n){for(var i=0;i<(n||1);i++){dt=0.016;time+=dt;update();}draw();},
  note:function(id){for(var i=0;i<notes.length;i++)if(notes[i].id===id&&!notes[i].got)takeNote(notes[i]);}
};














})();
</script></body></html>
